								</li>
							</ul>
							<a href="/contact" class="block text-center px-6 py-3 bg-construction-primary text-white rounded-lg font-semibold hover:bg-blue-600 hover:scale-105 transition-all">
								Learn More
							</a>
						</div>
					</div>
				</FadeInSection>

				<!-- Commercial Excavation -->
				<FadeInSection client:load delay={0.4}>
					<div id="excavation" class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow border-2 border-construction-primary/20 hover:border-construction-primary">
						<div class="h-48 bg-gradient-to-br from-yellow-600 to-orange-700 flex items-center justify-center">
							<div class="text-7xl">🚜</div>
						</div>
						<div class="p-8">
							<h2 class="text-3xl font-display font-bold text-construction-dark mb-4">
								Commercial Excavation
							</h2>
							<p class="text-gray-700 mb-6">
