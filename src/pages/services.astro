---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Services | JBS Construction";
const pageDescription = "Full-spectrum commercial construction services — new builds, remodels, and maintenance programs for national brands.";

const services = [
	{
		title: 'Ground-Up Construction',
		description: 'Full new-build execution for commercial properties. From site prep to punch list, one team owns it all.',
		features: ['Site preparation & grading', 'Foundation & structural', 'Full MEP coordination', 'Turnkey delivery'],
	},
	{
	title: 'Brand Refresh & Remodels',
		description: 'Brand refreshes, relocations, and full interior gut-renovations — on schedule, on budget, every time.',
		features: ['Interior demolition', 'Brand standard buildouts', 'ADA compliance updates', 'Phased & occupied renovations'],
	},
	{
		title: 'Maintenance Programs',
		description: 'Ongoing facility maintenance that protects your investment and keeps your locations running.',
		features: ['Preventive maintenance', 'Emergency response', 'Vendor management', 'Multi-site programs'],
	},
	{
		title: 'Tenant Improvements',
		description: 'Fast-track TI buildouts that meet brand specs and landlord requirements without the runaround.',
		features: ['Space planning', 'Permit management', 'Landlord coordination', 'Fast-track scheduling'],
	},
	{
		title: 'Design Builds',
		description: 'Dedicated PMs who own your project end-to-end — transparent updates, proactive problem-solving.',
		features: ['Dedicated project managers', 'Real-time reporting', 'Budget tracking', 'Schedule management'],
	},
	{
		title: 'National Rollouts',
		description: 'Multi-site new builds and renovations executed consistently from coast to coast with one point of contact.',
		features: ['Nationwide coverage', 'Consistent quality', 'Single point of contact', 'Scalable execution'],
	},
];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 left-1/3 w-[600px] h-[600px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">What We Do</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Our Services</h1>
					<p class="text-xl text-white/60 max-w-xl">Full-spectrum commercial construction — from ground-up builds to ongoing maintenance, all under one roof.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Services Grid -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{services.map((service, index) => (
					<FadeInSection client:load delay={index * 0.08}>
						<div class="group bg-white border border-jbs-beige p-8 hover:border-jbs-blue/30 hover:shadow-xl transition-all h-full flex flex-col">
							<h3 class="font-heading text-2xl text-jbs-dark uppercase mb-3">{service.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed mb-6">{service.description}</p>
							<ul class="mt-auto space-y-2">
								{service.features.map((feature) => (
									<li class="flex items-center gap-2 text-sm text-jbs-charcoal/60">
										<span class="w-1.5 h-1.5 bg-jbs-blue shrink-0"></span>
										{feature}
									</li>
								))}
							</ul>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Process -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Process</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">How We Build</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ step: '01', title: 'Discovery', desc: 'Scope alignment, site assessment, and clear expectations — before a single dollar is spent.' },
					{ step: '02', title: 'Pre-Construction', desc: 'Budgeting, permitting, scheduling, and vendor coordination — all buttoned up.' },
					{ step: '03', title: 'Execution', desc: 'Dedicated PM on-site. Proactive updates. Problems solved before you hear about them.' },
					{ step: '04', title: 'Delivery', desc: 'Punch list, final walk, and turnover — clean, complete, and on time.' },
				].map((item, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="text-center">
							<span class="font-heading text-6xl font-800 text-jbs-blue/20">{item.step}</span>
							<h3 class="font-heading text-xl text-jbs-dark uppercase mt-2 mb-3">{item.title}</h3>
							<p class="text-jbs-charcoal/60 text-sm leading-relaxed">{item.desc}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Built Different Band -->
	<section class="py-16 bg-jbs-blue">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<h2 class="font-heading text-4xl md:text-5xl font-800 text-white uppercase tracking-wide">One Call. One Team. Done Right.</h2>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-jbs-dark">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Ready to Build?</h2>
				<p class="text-white/50 text-lg mb-10 max-w-xl mx-auto">Tell us about your next project and we'll show you what Built Different looks like.</p>
				<a href="/contact" class="inline-block px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Contact Us</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
