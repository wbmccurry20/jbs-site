	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-accent/20 text-construction-accent font-semibold rounded-full mb-6">
						Our Services
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						Comprehensive Construction
						<span class="block text-construction-primary mt-2">Services</span>
					</h1>
					<p class="text-xl text-gray-300">
						Comprehensive construction solutions tailored to your vision. 
						From concept to completion, we handle every detail.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

