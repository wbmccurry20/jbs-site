						<div class="w-16 h-16 bg-construction-primary/10 rounded-full flex items-center justify-center mb-6">
							<svg class="w-8 h-8 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="text-xl font-display font-bold text-construction-dark mb-3">
							Fast Turnaround
						</h3>
