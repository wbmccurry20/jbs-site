---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Construction Services | JBS Construction";
const pageDescription = "Comprehensive residential construction services including new home builds, renovations, additions, and green building in Western North Carolina.";
