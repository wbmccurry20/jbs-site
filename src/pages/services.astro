---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Commercial Construction Services | JBS Construction";
const pageDescription = "Comprehensive commercial construction services including oil change facilities, car washes, restaurant build-outs, and retail construction nationwide.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero Section -->
	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black relative">
		<!-- Blue Glow Overlay -->
		<div class="absolute inset-0 bg-construction-primary/15 mix-blend-overlay pointer-events-none"></div>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-primary/20 text-construction-primary font-semibold rounded-full mb-6">
						Our Services
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						Commercial Construction
						<span class="block text-construction-primary mt-2">Solutions</span>
					</h1>
					<p class="text-xl text-gray-300">
						Specialized in multi-unit rollouts for national brands.
						From concept to completion, we deliver on time and on budget.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Services Grid -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 gap-8">
				<!-- Oil Change Facilities -->
				<FadeInSection client:load delay={0.1}>
					<div id="oil-change" class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow border-2 border-construction-primary/20 hover:border-construction-primary">
						<div class="h-48 bg-gradient-to-br from-construction-primary to-blue-600 flex items-center justify-center">
							<div class="text-7xl">🚗</div>
						</div>
						<div class="p-8">
							<h2 class="text-3xl font-display font-bold text-construction-dark mb-4">
								Oil Change Facilities
							</h2>
							<p class="text-gray-700 mb-6">
								Turn-key construction for quick lube facilities. Trusted by national brands for our speed,
								quality, and expertise in this specialized market.
							</p>
							<h3 class="font-semibold text-construction-dark mb-3">Brands We Work With:</h3>
							<ul class="space-y-2 mb-6">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Take 5 Oil Change</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Valvoline Instant Oil Change</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Jiffy Lube</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Quick lube franchises nationwide</span>
								</li>
							</ul>
							<a href="/contact" class="block text-center px-6 py-3 bg-construction-primary text-white rounded-lg font-semibold hover:bg-blue-600 hover:scale-105 transition-all">
								Learn More
							</a>
						</div>
					</div>
				</FadeInSection>

				<!-- Car Wash Construction -->
				<FadeInSection client:load delay={0.2}>
					<div id="car-wash" class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow border-2 border-construction-primary/20 hover:border-construction-primary">
						<div class="h-48 bg-gradient-to-br from-blue-500 to-construction-primary flex items-center justify-center">
							<div class="text-7xl">🚙</div>
						</div>
						<div class="p-8">
							<h2 class="text-3xl font-display font-bold text-construction-dark mb-4">
								Car Wash Construction
							</h2>
							<p class="text-gray-700 mb-6">
								Full-service and express car wash facilities. We understand the unique requirements
								of automated wash systems and tunnel construction.
							</p>
							<h3 class="font-semibold text-construction-dark mb-3">What We Build:</h3>
							<ul class="space-y-2 mb-6">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Express tunnel car washes</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Full-service wash facilities</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									<span class="text-gray-700">Detail centers and vacuum stations</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-construction-primary mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
