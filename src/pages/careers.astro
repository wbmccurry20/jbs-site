---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Careers | JBS Construction";
const pageDescription = "Join the JBS Construction team. We're hiring project managers, estimators, and construction professionals across the country.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />

	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<img src="/images/stock/stock_photo3.jpg" alt="JBS Construction team" class="w-full h-full object-cover object-center opacity-25" loading="eager" />
			<div class="absolute inset-0 bg-gradient-to-r from-jbs-dark via-jbs-dark/85 to-jbs-dark/70"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Careers</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Join the Team</h1>
					<p class="text-xl text-white/60 max-w-xl">We build differently — and we hire the same way.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Why JBS -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Why Work Here?</p>
						<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark mb-8">We Invest In Our People</h2>
						<div class="space-y-4 text-jbs-charcoal/80 leading-relaxed">
							<p>We're a growing national company — which means real career paths, real promotions, and room to build something long-term.</p>
							<p>You'll have ownership over your work and direct access to leadership. No corporate bureaucracy. No waiting years to matter.</p>
							<p>We move fast and solve problems. If something's broken, we fix it. If a system is slow, we change it.</p>
							<p>This is a tight-knit team. Your name and your effort are actually known here.</p>
						</div>
					</div>
				</FadeInSection>
				<FadeInSection client:load>
					<div class="bg-jbs-dark p-12">
						<h3 class="font-heading text-3xl text-jbs-blue uppercase mb-6">We Take Care of Our People. Full Stop.</h3>
						<div class="text-white/70 leading-relaxed space-y-4">
							<p>Every person on this team was hired because we saw something in them. We invest in that — with compensation, growth, and genuine respect.</p>
							<p>When you win here, the whole company wins. That's not a slogan. That's how we operate.</p>
						</div>
						<div class="mt-8 pt-8 border-t border-white/10">
							<p class="font-heading text-xl text-white uppercase">Ready to Build Something? Let's Talk.</p>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">What We Offer</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Benefits &amp; Perks</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						title: 'Competitive Compensation',
						description: 'Pay that reflects your skill, your effort, and the market.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
					},
					{
						title: 'Full Health Benefits',
						description: 'Medical, dental, and vision coverage for you and your family.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />',
					},
					{
						title: '401(k) Retirement Plan',
						description: 'Company-supported retirement planning from day one.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />',
					},
					{
						title: 'Paid Time Off',
						description: 'Take the time you need. We trust our people.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />',
					},
					{
						title: 'Career Growth',
						description: 'Clear promotion paths and mentorship from experienced leaders.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />',
					},
					{
						title: 'Remote-Friendly Roles',
						description: 'Many of our positions are fully remote or hybrid.',
						icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />',
					},
				].map((benefit, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-jbs-blue hover:shadow-xl transition-shadow">
							<svg class="w-8 h-8 text-jbs-blue mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={benefit.icon} />
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{benefit.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{benefit.description}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Open Roles -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Now Hiring</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Open Positions</h2>
				</div>
			</FadeInSection>
			<div class="max-w-4xl mx-auto space-y-4">
				{[
					{ title: 'Project Manager',            department: 'Project Management' },
					{ title: 'Assistant Project Manager',  department: 'Project Management' },
					{ title: 'Estimator',                  department: 'Pre-Construction'   },
					{ title: 'Construction Administrator', department: 'Operations'         },
				].map((role, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white border border-jbs-beige border-l-4 border-l-jbs-blue shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
							<div>
								<h3 class="font-heading text-xl text-jbs-dark uppercase">{role.title}</h3>
								<div class="flex items-center gap-3 mt-1 flex-wrap">
									<span class="bg-jbs-blue/10 text-jbs-blue font-heading text-xs uppercase tracking-wider px-2 py-0.5">{role.department}</span>
									<span class="text-jbs-charcoal/50 text-sm">Nationwide / Remote</span>
								</div>
							</div>
							<a href="mailto:info@jbsconstructiongroup.com" class="inline-block bg-jbs-blue text-white font-heading text-sm uppercase tracking-wider px-6 py-2.5 hover:bg-jbs-blue/90 transition-all whitespace-nowrap">
								Apply Now &rarr;
							</a>
						</div>
					</FadeInSection>
				))}
				<FadeInSection client:load delay={0.4}>
					<div class="bg-jbs-beige/40 border border-jbs-beige border-l-4 border-l-jbs-gray p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
						<div>
							<h3 class="font-heading text-xl text-jbs-charcoal/40 uppercase">More Roles Coming Soon</h3>
							<div class="flex items-center gap-3 mt-1 flex-wrap">
								<span class="bg-jbs-gray/10 text-jbs-gray font-heading text-xs uppercase tracking-wider px-2 py-0.5">Stay Tuned</span>
							</div>
						</div>
						<span class="text-jbs-charcoal/30 font-heading text-sm uppercase tracking-wider">Check Back Soon</span>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-24 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-jbs-blue/[0.05] rotate-45 -translate-x-1/2 translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Don't See Your Role?</h2>
				<p class="text-xl text-white/60 max-w-xl mx-auto mb-10">We're always looking for exceptional people. Send us your resume and tell us what you bring to the table.</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="mailto:info@jbsconstructiongroup.com" class="px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Send Your Resume &rarr;</a>
					<a href="/portfolio" class="px-10 py-4 border-2 border-white/20 text-white font-heading text-lg uppercase tracking-wider hover:border-jbs-blue hover:text-jbs-blue transition-all">View Our Work &rarr;</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
