---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Divisions | JBS Construction";
const pageDescription = "JBS Construction Divisions — Auto-Retail, QSR, Healthcare, and Site & Civil. Full-spectrum commercial construction nationwide.";

const divisions = [
  {
    name: 'Auto-Retail',
    href: '/divisions/auto-retail',
    description: 'Car washes, oil changes, tire shops — we know automotive retail and we build it right.',
    offerings: ['Ground-Up Construction', 'Brand Refresh + Renovations', 'National Rollouts', 'Franchise Development'],
  },
  {
    name: 'QSR',
    href: '/divisions/qsr',
    description: 'Quick-service restaurants built to brand standard, on schedule, and ready to open.',
    offerings: ['Ground-Up Construction', 'Tenant Improvements', 'National Rollouts', 'Maintenance Programs'],
  },
  {
    name: 'Healthcare',
    href: '/divisions/healthcare',
    description: 'Medical and dental facilities built to spec, on schedule, with zero tolerance for disruption.',
    offerings: ['Ground-Up Construction', 'Tenant Improvements', 'Brand Refresh + Renovations', 'Design Build'],
  },
  {
    name: 'Site & Civil',
    href: '/divisions/site-civil',
    description: 'The work that happens before the building goes up — done right the first time.',
    offerings: ['Utilities', 'Excavation', 'Grading', 'Foundations'],
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:load />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/stock/stock_photo1.png" alt="JBS Construction Divisions" class="w-full h-full object-cover object-center opacity-25" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-jbs-dark via-jbs-dark/85 to-jbs-dark/70"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FadeInSection client:load>
        <div class="max-w-3xl">
          <p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">What We Do</p>
          <h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Our Divisions</h1>
          <p class="text-xl text-white/60 max-w-xl">Four focused divisions. One standard of quality. Built Different — nationwide.</p>
        </div>
      </FadeInSection>
    </div>
  </section>

  <!-- Division Cards -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        {divisions.map((division, index) => (
          <FadeInSection client:load delay={index * 0.08}>
            <a
              href={division.href}
              class="group block bg-white border border-jbs-beige p-10 hover:border-jbs-blue/30 hover:shadow-xl transition-all h-full"
            >
              <div class="flex items-start justify-between mb-4">
                <h2 class="font-heading text-3xl text-jbs-dark uppercase group-hover:text-jbs-blue transition-colors">{division.name}</h2>
                <svg class="w-5 h-5 text-jbs-blue/0 group-hover:text-jbs-blue transition-all translate-x-0 group-hover:translate-x-1 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
              <p class="text-jbs-charcoal/60 text-sm leading-relaxed mb-6">{division.description}</p>
              <ul class="space-y-2">
                {division.offerings.map((offering) => (
                  <li class="flex items-center gap-2 text-sm text-jbs-charcoal/50">
                    <span class="w-1.5 h-1.5 bg-jbs-blue shrink-0"></span>
                    {offering}
                  </li>
                ))}
              </ul>
            </a>
          </FadeInSection>
        ))}
      </div>
    </div>
  </section>

  <!-- Blue band CTA -->
  <section class="py-16 bg-jbs-blue">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-800 text-white uppercase tracking-wide">One Call. One Team. Done Right.</h2>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-jbs-dark">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <FadeInSection client:load>
        <h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Ready to Build?</h2>
        <p class="text-white/50 text-lg mb-10 max-w-xl mx-auto">Tell us about your next project and we'll show you what Built Different looks like.</p>
        <a href="/contact" class="inline-block px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Contact Us</a>
      </FadeInSection>
    </div>
  </section>

  <Footer />
</Layout>
