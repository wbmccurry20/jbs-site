---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import FadeInSection from '../../components/FadeInSection';
import Footer from '../../components/Footer';

const pageTitle = "Client Portal | JBS Construction";
const pageDescription =
  "The JBS client portal gives trade partners access to project workflow tools — including subcontractor onboarding and payment application forms.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:load />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-jbs-blue/5 rotate-45 translate-y-1/2"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FadeInSection client:load>
        <div class="max-w-3xl">
          <p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">
            Client Portal
          </p>
          <h1 class="font-heading text-5xl md:text-7xl font-800 text-white mb-6 uppercase">
            Tools For<br />Trade Partners
          </h1>
          <p class="text-xl text-white/60 max-w-2xl leading-relaxed">
            This portal is where JBS trade partners can access forms and project workflow tools.
            Use the links below to submit a subcontractor questionnaire or preview the upcoming
            payment application workflow.
          </p>
        </div>
      </FadeInSection>
    </div>
  </section>

  <!-- Portal tools -->
  <section class="py-24 bg-jbs-dark border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FadeInSection client:load>
        <p class="font-heading text-xs uppercase tracking-widest text-jbs-blue mb-10">
          Available Tools
        </p>
        <div class="grid md:grid-cols-2 gap-6">

          <!-- Card 1: Subcontractor Questionnaire -->
          <div class="bg-white/5 border border-white/10 p-8 flex flex-col gap-6 hover:border-jbs-blue/30 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-heading text-xs uppercase tracking-widest text-jbs-blue mb-3">
                  01 &middot; Trade Partner Onboarding
                </p>
                <h2 class="font-heading text-2xl text-white uppercase">
                  Subcontractor Questionnaire
                </h2>
              </div>
              <span class="shrink-0 font-heading text-[10px] uppercase tracking-widest text-green-400 bg-green-400/10 border border-green-400/20 px-3 py-1">
                Active
              </span>
            </div>
            <p class="text-white/60 leading-relaxed">
              Trade partners interested in working with JBS can introduce their company, trades,
              geographic coverage, bonding capacity, and key qualifications. Submissions go directly
              to the JBS team for review.
            </p>
            <div class="mt-auto">
              <a
                href="/client-portal/subcontractors"
                class="inline-block px-8 py-3 bg-jbs-blue text-white font-heading text-sm uppercase tracking-widest hover:bg-jbs-blue/90 transition-colors"
              >
                Start Questionnaire &rarr;
              </a>
            </div>
          </div>

          <!-- Card 2: Payment Application -->
          <div class="bg-white/5 border border-white/10 p-8 flex flex-col gap-6 hover:border-jbs-blue/30 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-heading text-xs uppercase tracking-widest text-jbs-blue mb-3">
                  02 &middot; Accounts Payable
                </p>
                <h2 class="font-heading text-2xl text-white uppercase">
                  Payment Application
                </h2>
              </div>
              <span class="shrink-0 font-heading text-[10px] uppercase tracking-widest text-jbs-gold bg-jbs-gold/10 border border-jbs-gold/20 px-3 py-1">
                Prototype
              </span>
            </div>
            <p class="text-white/60 leading-relaxed">
              Frontend prototype for the planned JBS-branded payment application workflow. You can
              complete all form steps and review auto-calculated totals. Payment processing, PDF
              generation, and email delivery are not yet active.
            </p>
            <div class="mt-auto">
              <a
                href="/client-portal/payment-application"
                class="inline-block px-8 py-3 border border-jbs-blue/50 text-jbs-blue font-heading text-sm uppercase tracking-widest hover:bg-jbs-blue/10 transition-colors"
              >
                View Prototype &rarr;
              </a>
            </div>
          </div>

        </div>
      </FadeInSection>
    </div>
  </section>

  <!-- Roadmap note -->
  <section class="py-20 bg-jbs-dark border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <FadeInSection client:load>
        <div class="max-w-2xl">
          <p class="font-heading text-xs uppercase tracking-widest text-jbs-blue mb-4">
            What&rsquo;s Coming
          </p>
          <h2 class="font-heading text-3xl text-white uppercase mb-6">
            More Tools on the Way
          </h2>
          <p class="text-white/60 leading-relaxed mb-4">
            The portal is being built incrementally. Future tools under consideration include
            payment application processing, AP workflow and certificate management, admin review
            dashboards, and client-facing project status tools.
          </p>
          <p class="text-white/40 text-sm leading-relaxed">
            This page will be updated as new tools become available. Not all features described
            are committed to a specific timeline.
          </p>
        </div>
      </FadeInSection>
    </div>
  </section>

  <Footer />
</Layout>
