---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import { LICENSED_STATES } from '../data/licensedStates';
import { geoAlbersUsa, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import { readFileSync } from 'fs';
import { join } from 'path';

const topoJson = JSON.parse(
  readFileSync(join(process.cwd(), 'public/us-states.json'), 'utf-8')
);
const FIPS_TO_ABBR: Record<string, string> = {
  '01': 'AL', '02': 'AK', '04': 'AZ', '05': 'AR', '06': 'CA',
  '08': 'CO', '09': 'CT', '10': 'DE', '11': 'DC', '12': 'FL',
  '13': 'GA', '15': 'HI', '16': 'ID', '17': 'IL', '18': 'IN',
  '19': 'IA', '20': 'KS', '21': 'KY', '22': 'LA', '23': 'ME',
  '24': 'MD', '25': 'MA', '26': 'MI', '27': 'MN', '28': 'MS',
  '29': 'MO', '30': 'MT', '31': 'NE', '32': 'NV', '33': 'NH',
  '34': 'NJ', '35': 'NM', '36': 'NY', '37': 'NC', '38': 'ND',
  '39': 'OH', '40': 'OK', '41': 'OR', '42': 'PA', '44': 'RI',
  '45': 'SC', '46': 'SD', '47': 'TN', '48': 'TX', '49': 'UT',
  '50': 'VT', '51': 'VA', '53': 'WA', '54': 'WV', '55': 'WI',
  '56': 'WY',
};
const STATE_NAMES: Record<string, string> = {
  AL: 'Alabama', AK: 'Alaska', AZ: 'Arizona', AR: 'Arkansas', CA: 'California',
  CO: 'Colorado', CT: 'Connecticut', DE: 'Delaware', FL: 'Florida', GA: 'Georgia',
  HI: 'Hawaii', ID: 'Idaho', IL: 'Illinois', IN: 'Indiana', IA: 'Iowa',
  KS: 'Kansas', KY: 'Kentucky', LA: 'Louisiana', ME: 'Maine', MD: 'Maryland',
  MA: 'Massachusetts', MI: 'Michigan', MN: 'Minnesota', MS: 'Mississippi', MO: 'Missouri',
  MT: 'Montana', NE: 'Nebraska', NV: 'Nevada', NH: 'New Hampshire', NJ: 'New Jersey',
  NM: 'New Mexico', NY: 'New York', NC: 'North Carolina', ND: 'North Dakota', OH: 'Ohio',
  OK: 'Oklahoma', OR: 'Oregon', PA: 'Pennsylvania', RI: 'Rhode Island', SC: 'South Carolina',
  SD: 'South Dakota', TN: 'Tennessee', TX: 'Texas', UT: 'Utah', VT: 'Vermont',
  VA: 'Virginia', WA: 'Washington', WV: 'West Virginia', WI: 'Wisconsin', WY: 'Wyoming',
};
const projection = geoAlbersUsa().scale(1280).translate([480, 300]);
const pathGenerator = geoPath(projection);
const geojson = feature(topoJson, topoJson.objects.states);
const licensedSet = new Set(LICENSED_STATES);
const stateData = (geojson as any).features
  .map((f: any) => {
    const fips = String(f.id).padStart(2, '0');
    const abbr = FIPS_TO_ABBR[fips] ?? '';
    if (!abbr) return null;
    return { abbr, name: STATE_NAMES[abbr] ?? abbr, path: pathGenerator(f) ?? '', licensed: licensedSet.has(abbr) };
  })
  .filter(Boolean);
---

<Layout title="JBS | Built Different" description="JBS Construction — Built Different. Nationwide commercial construction with 120+ cities, 490+ projects managed, and end-to-end project management.">
	<Navbar client:load />

	<!-- ===================== HERO ===================== -->
	<section class="relative min-h-screen flex items-center overflow-hidden bg-jbs-dark">
		<!-- Angular geometric background shapes -->
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-white/[0.03] rotate-45 -translate-y-1/2"></div>
			<div class="absolute bottom-0 right-1/4 w-[800px] h-[800px] bg-white/[0.02] rotate-12 translate-y-1/3"></div>
			<div class="absolute top-1/3 right-0 w-[400px] h-[400px] bg-white/[0.04] -rotate-12 translate-x-1/3"></div>
			<div class="absolute bottom-1/4 left-0 w-[300px] h-[300px] bg-jbs-blue/[0.05] rotate-45 -translate-x-1/2"></div>
		</div>

		<!-- Hero background photo -->
		<div class="absolute inset-0">
			<img src="/images/projects/Draper_1.png" alt="JBS Construction — Mister Car Wash, Draper UT" class="w-full h-full object-cover object-center" loading="eager" />
		</div>
		<!-- Gradient overlay -->
		<div class="absolute inset-0 bg-gradient-to-r from-jbs-dark via-jbs-dark/90 to-jbs-dark/50"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<!-- Left: Headline -->
				<div>
					<p class="font-heading text-lg md:text-xl text-white/60 uppercase tracking-widest mb-4">
						We're JBS and We Are
					</p>
					<h1 class="font-heading text-7xl md:text-8xl lg:text-9xl font-900 text-white leading-[0.9] mb-8">
						Built<br/>Different
					</h1>
					<a
						href="/portfolio"
						class="inline-flex items-center px-8 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 hover:shadow-xl hover:shadow-jbs-blue/20 transition-all group"
					>
						View Our Work
						<svg class="ml-3 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>

				<!-- Right: Stats -->
				<div class="hidden lg:flex flex-col space-y-8 pl-12 border-l border-white/10">
					<div>
						<span class="font-heading text-5xl font-800 text-white">120+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Cities</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-white">88+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Active Projects</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-jbs-blue">End-to-End</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Project Management</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-white">490+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Projects Managed</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Scroll indicator -->
		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
			<div class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center">
				<div class="w-1 h-3 bg-white/40 rounded-full mt-2 animate-bounce"></div>
			</div>
		</div>
	</section>

	<!-- ===================== MOBILE STATS (shown below hero on small screens) ===================== -->
	<section class="lg:hidden bg-jbs-charcoal py-12">
		<div class="max-w-7xl mx-auto px-4 grid grid-cols-2 gap-8 text-center">
			<div>
				<span class="font-heading text-4xl font-800 text-white">120+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Cities</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-white">88+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Active Projects</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-jbs-blue">E2E</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Project Management</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-white">490+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Projects Managed</p>
			</div>
		</div>
	</section>

	<!-- ===================== CLIENT LOGO STRIP ===================== -->
	<section class="py-10 bg-jbs-charcoal border-y border-white/10 overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 text-center">
			<p class="font-heading text-xs uppercase tracking-widest text-white/40">Trusted By</p>
		</div>
		<div class="relative">
			<!-- Fade edges -->
			<div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-jbs-charcoal to-transparent z-10 pointer-events-none"></div>
			<div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-jbs-charcoal to-transparent z-10 pointer-events-none"></div>
			<!-- Scrolling track — duplicated for seamless loop -->
			<div class="flex logo-marquee">
				{[
					'Take 5 Oil Change',
					'Mister Carwash',
					'Driven Brands',
					'Valvoline',
					'Tidal Wave Auto Spa',
					'7 Brew',
					'Grease Monkey',
					'AutoZone',
					'Fast Oil',
					'Durban Group',
				].concat([
					'Take 5 Oil Change',
					'Mister Carwash',
					'Driven Brands',
					'Valvoline',
					'Tidal Wave Auto Spa',
					'7 Brew',
					'Grease Monkey',
					'AutoZone',
					'Fast Oil',
					'Durban Group',
				]).map((name) => (
					<span class="logo-item font-heading text-sm uppercase tracking-widest text-white/50 whitespace-nowrap px-10 border-r border-white/10 last:border-r-0 hover:text-white/80 transition-colors">
						{name}
					</span>
				))}
			</div>
		</div>
	</section>

	<style>
		.logo-marquee {
			animation: marquee 30s linear infinite;
			width: max-content;
		}
		.logo-marquee:hover {
			animation-play-state: paused;
		}
		@keyframes marquee {
			from { transform: translateX(0); }
			to   { transform: translateX(-50%); }
		}
		@media (prefers-reduced-motion: reduce) {
			.logo-marquee {
				animation: none;
				flex-wrap: wrap;
				justify-content: center;
				width: 100%;
			}
		}
	</style>

	<!-- ===================== FEATURED PROJECT ===================== -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Recent Work</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">
						Featured Projects
					</h2>
				</div>
			</FadeInSection>

			<!-- Featured project cards -->
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{[
					{ title: 'Take 5 Oil Change', location: 'Colorado Springs, CO', category: 'Ground-Up', image: '/images/projects/take5_coSprings.jpg' },
					{ title: 'Tidal Wave Auto Spa', location: 'Early, TX', category: 'Ground-Up', image: '/images/projects/tidal_wave_auto_spa_Early_TX1.jpg' },
					{ title: 'Mister Car Wash', location: 'Tucson, AZ', category: 'Ground-Up', image: '/images/projects/mister_car_wash_Tucson_AZ1.jpg' },
				].map((project) => (
					<FadeInSection client:load>
						<div class="group relative overflow-hidden bg-jbs-cream aspect-[4/3]">
							<img
								src={project.image}
								alt={project.title}
								class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-jbs-dark/90 via-jbs-dark/20 to-transparent"></div>
							<div class="absolute bottom-0 left-0 right-0 p-6 translate-y-1 group-hover:translate-y-0 transition-transform">
								<p class="text-jbs-blue font-heading text-xs uppercase tracking-widest mb-1">{project.category}</p>
								<h3 class="font-heading text-xl text-white uppercase">{project.title}</h3>
								<p class="text-white/60 text-sm mt-0.5">{project.location}</p>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>

			<div class="text-center mt-12">
				<a href="/portfolio" class="inline-flex items-center px-8 py-4 border-2 border-jbs-dark text-jbs-dark font-heading text-sm uppercase tracking-wider hover:bg-jbs-dark hover:text-white transition-all group">
					View More Projects
					<svg class="ml-3 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- ===================== WHAT WE DO ===================== -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Services</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">
						What We Build
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				{[
					{ title: 'Ground-Up Construction', desc: 'New builds from foundation to finish, delivered on time and on budget.' },
					{ title: 'Brand Refresh + Renovations', desc: 'Transforming existing spaces with precision and minimal disruption.' },
					{ title: 'Design Build', desc: 'Integrated design and construction under one team — faster delivery, tighter budgets.' },
					{ title: 'Maintenance Programs', desc: 'Custom solutions for unique construction challenges nationwide.' },
				].map((service) => (
					<FadeInSection client:load>
						<div class="p-8 bg-white border-t-4 border-jbs-blue hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{service.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{service.desc}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- ===================== TAGLINE BAND ===================== -->
	<section class="py-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white/[0.02] rotate-45 translate-x-1/2 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
			<h2 class="font-heading text-5xl md:text-7xl font-900 text-white leading-tight">
				We're Built Different<br/>
				<span class="text-jbs-blue">By Leaders Like You.</span>
			</h2>
			<div class="mt-10">
				<a href="/contact" class="inline-flex items-center px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 hover:shadow-xl hover:shadow-jbs-blue/20 transition-all">
					Let's Connect
				</a>
			</div>
		</div>
	</section>

	<!-- ===================== HOW WE BUILD ===================== -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Process</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">How We Build</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ step: '01', title: 'Discovery', desc: 'Scope alignment, site assessment, and clear expectations — before a single dollar is spent.' },
					{ step: '02', title: 'Pre-Construction', desc: 'Budgeting, permitting, scheduling, and vendor coordination — all buttoned up.' },
					{ step: '03', title: 'Execution', desc: 'Dedicated PM on-site. Proactive updates. Problems solved before you hear about them.' },
					{ step: '04', title: 'Delivery', desc: 'Punch list, final walk, and turnover — clean, complete, and on time.' },
				].map((item, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="text-center">
							<span class="font-heading text-6xl font-800 text-jbs-blue/20">{item.step}</span>
							<h3 class="font-heading text-xl text-jbs-dark uppercase mt-2 mb-3">{item.title}</h3>
							<p class="text-jbs-charcoal/60 text-sm leading-relaxed">{item.desc}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- ===================== WHERE WE BUILD (MAP) ===================== -->
	<section class="py-24 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0 opacity-[0.04]" style="background-image:radial-gradient(circle,#ffffff 1px,transparent 1px);background-size:32px 32px;"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Where We Build</p>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Licensed Across the Nation</h2>
				<div class="inline-flex items-center gap-2.5 px-5 py-2.5 border border-jbs-blue/40 bg-jbs-blue/10">
					<span class="w-2 h-2 bg-jbs-blue inline-block"></span>
					<span class="font-heading text-jbs-blue text-sm uppercase tracking-widest">
						Licensed in {LICENSED_STATES.length} State{LICENSED_STATES.length !== 1 ? 's' : ''}
					</span>
				</div>
			</div>
			<div class="relative w-full max-w-5xl mx-auto" id="map-container">
				<svg viewBox="0 0 960 600" class="w-full h-auto block" id="us-map">
					{stateData.map((s: { abbr: string; name: string; path: string; licensed: boolean }) => (
						<path
							d={s.path}
							fill={s.licensed ? '#00A0E0' : '#1e2a35'}
							stroke="#0d1a24"
							stroke-width="0.6"
							class="state-path"
							data-name={s.name}
							data-licensed={s.licensed ? 'true' : 'false'}
							style="cursor:pointer;transition:fill 0.15s ease;"
						/>
					))}
				</svg>
				<div id="map-tooltip" class="pointer-events-none absolute z-20 hidden px-3 py-1.5 text-xs font-heading uppercase tracking-wider whitespace-nowrap" style="transform:translate(-50%,-130%);"></div>
			</div>
			<div class="flex items-center justify-center gap-10 mt-8">
				<div class="flex items-center gap-2.5">
					<span class="w-3 h-3 inline-block" style="background:#00A0E0;"></span>
					<span class="text-white/60 text-xs font-heading uppercase tracking-widest">Licensed</span>
				</div>
				<div class="w-px h-4 bg-white/10"></div>
				<div class="flex items-center gap-2.5">
					<span class="w-3 h-3 inline-block" style="background:#1e2a35;border:1px solid #2a3a4a;"></span>
					<span class="text-white/30 text-xs font-heading uppercase tracking-widest">Not Yet Licensed</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== OUR CREW TEASER ===================== -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-center">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Crew</p>
						<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark mb-6">
							Real Crews.<br/>Real Sites.<br/>Real Results.
						</h2>
						<p class="text-jbs-charcoal/70 leading-relaxed mb-8 max-w-lg">
							At JBS, our people are our difference. Experienced superintendents, skilled craftsmen, 
							and dedicated project managers working together to deliver exceptional results — every time.
						</p>
						<a href="/about" class="inline-flex items-center font-heading text-sm uppercase tracking-wider text-jbs-blue hover:text-jbs-dark transition-colors group">
							Meet the Team
							<svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
							</svg>
						</a>
					</div>
				</FadeInSection>
				<FadeInSection client:load>
				<div class="aspect-[4/3] bg-jbs-dark flex flex-col items-center justify-center p-12 text-center">
					<span class="font-heading text-6xl font-800 text-white/10 leading-none mb-4">490+</span>
					<span class="font-heading text-xl text-white uppercase tracking-wider">Projects Managed</span>
					<span class="text-white/40 text-sm mt-2">Nationwide</span>
					<div class="mt-8 w-16 h-1 bg-jbs-blue"></div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<script>
  const container = document.getElementById('map-container');
  const tooltip = document.getElementById('map-tooltip');
  document.querySelectorAll<SVGPathElement>('.state-path').forEach((path) => {
    const name = path.dataset.name ?? '';
    const licensed = path.dataset.licensed === 'true';
    path.addEventListener('mouseenter', () => path.setAttribute('fill', licensed ? '#33b8f0' : '#263545'));
    path.addEventListener('mouseleave', () => {
      path.setAttribute('fill', licensed ? '#00A0E0' : '#1e2a35');
      tooltip?.classList.add('hidden');
    });
    path.addEventListener('mousemove', (e) => {
      if (!tooltip || !container) return;
      const rect = container.getBoundingClientRect();
      tooltip.style.left = `${((e.clientX - rect.left) / rect.width) * 100}%`;
      tooltip.style.top = `${((e.clientY - rect.top) / rect.height) * 100}%`;
      tooltip.style.background = licensed ? '#00A0E0' : '#111c26';
      tooltip.style.color = '#fff';
      tooltip.style.border = licensed ? '1px solid #33b8f0' : '1px solid #2a3a4a';
      tooltip.style.boxShadow = licensed ? '0 4px 20px rgba(0,160,224,0.35)' : '0 4px 12px rgba(0,0,0,0.5)';
      tooltip.textContent = licensed ? `✓ ${name}` : name;
      tooltip.classList.remove('hidden');
    });
  });
</script>
