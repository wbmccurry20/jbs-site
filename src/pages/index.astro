---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
---

<Layout title="JBS | Built Different" description="JBS Construction — Built Different. Nationwide commercial construction with 120+ cities, 490+ projects managed, and end-to-end project management.">
	<Navbar client:load />

	<!-- ===================== HERO ===================== -->
	<section class="relative min-h-screen flex items-center overflow-hidden bg-jbs-dark">
		<!-- Angular geometric background shapes -->
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-white/[0.03] rotate-45 -translate-y-1/2"></div>
			<div class="absolute bottom-0 right-1/4 w-[800px] h-[800px] bg-white/[0.02] rotate-12 translate-y-1/3"></div>
			<div class="absolute top-1/3 right-0 w-[400px] h-[400px] bg-white/[0.04] -rotate-12 translate-x-1/3"></div>
			<div class="absolute bottom-1/4 left-0 w-[300px] h-[300px] bg-jbs-blue/[0.05] rotate-45 -translate-x-1/2"></div>
		</div>

		<!-- Hero background photo -->
		<div class="absolute inset-0">
			<img src="/images/projects/Draper_1.png" alt="JBS Construction — Mister Car Wash, Draper UT" class="w-full h-full object-cover object-center" loading="eager" />
		</div>
		<!-- Gradient overlay -->
		<div class="absolute inset-0 bg-gradient-to-r from-jbs-dark via-jbs-dark/90 to-jbs-dark/50"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<!-- Left: Headline -->
				<div>
					<p class="font-heading text-lg md:text-xl text-white/60 uppercase tracking-widest mb-4">
						We're JBS and We Are
					</p>
					<h1 class="font-heading text-7xl md:text-8xl lg:text-9xl font-900 text-white leading-[0.9] mb-8">
						Built<br/>Different
					</h1>
					<a
						href="/portfolio"
						class="inline-flex items-center px-8 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 hover:shadow-xl hover:shadow-jbs-blue/20 transition-all group"
					>
						View Our Work
						<svg class="ml-3 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>

				<!-- Right: Stats -->
				<div class="hidden lg:flex flex-col space-y-8 pl-12 border-l border-white/10">
					<div>
						<span class="font-heading text-5xl font-800 text-white">120+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Cities</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-white">88+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Active Projects</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-jbs-blue">End-to-End</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Project Management</p>
					</div>
					<div>
						<span class="font-heading text-5xl font-800 text-white">490+</span>
						<p class="text-white/50 font-heading text-sm uppercase tracking-widest mt-1">Projects Managed</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Scroll indicator -->
		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
			<div class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center">
				<div class="w-1 h-3 bg-white/40 rounded-full mt-2 animate-bounce"></div>
			</div>
		</div>
	</section>

	<!-- ===================== MOBILE STATS (shown below hero on small screens) ===================== -->
	<section class="lg:hidden bg-jbs-charcoal py-12">
		<div class="max-w-7xl mx-auto px-4 grid grid-cols-2 gap-8 text-center">
			<div>
				<span class="font-heading text-4xl font-800 text-white">120+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Cities</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-white">88+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Active Projects</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-jbs-blue">E2E</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Project Management</p>
			</div>
			<div>
				<span class="font-heading text-4xl font-800 text-white">490+</span>
				<p class="text-white/50 font-heading text-xs uppercase tracking-widest mt-1">Projects Managed</p>
			</div>
		</div>
	</section>

	<!-- ===================== FEATURED PROJECT ===================== -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Recent Work</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">
						Featured Projects
					</h2>
				</div>
			</FadeInSection>

			<!-- Featured project cards -->
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{[
					{ title: 'Take 5 Oil Change', location: 'Colorado Springs, CO', category: 'Ground-Up', image: '/images/projects/take5_coSprings.jpg' },
					{ title: 'Tidal Wave Auto Spa', location: 'Early, TX', category: 'Ground-Up', image: '/images/projects/tidal_wave_auto_spa_Early_TX1.jpg' },
					{ title: 'Mister Car Wash', location: 'Tucson, AZ', category: 'Ground-Up', image: '/images/projects/mister_car_wash_Tucson_AZ1.jpg' },
				].map((project) => (
					<FadeInSection client:load>
						<div class="group relative overflow-hidden bg-jbs-cream aspect-[4/3]">
							<img
								src={project.image}
								alt={project.title}
								class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-jbs-dark/90 via-jbs-dark/20 to-transparent"></div>
							<div class="absolute bottom-0 left-0 right-0 p-6 translate-y-1 group-hover:translate-y-0 transition-transform">
								<p class="text-jbs-blue font-heading text-xs uppercase tracking-widest mb-1">{project.category}</p>
								<h3 class="font-heading text-xl text-white uppercase">{project.title}</h3>
								<p class="text-white/60 text-sm mt-0.5">{project.location}</p>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>

			<div class="text-center mt-12">
				<a href="/portfolio" class="inline-flex items-center px-8 py-4 border-2 border-jbs-dark text-jbs-dark font-heading text-sm uppercase tracking-wider hover:bg-jbs-dark hover:text-white transition-all group">
					View More Projects
					<svg class="ml-3 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- ===================== WHAT WE DO ===================== -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Services</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">
						What We Build
					</h2>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				{[
					{ title: 'Ground-Up Construction', desc: 'New builds from foundation to finish, delivered on time and on budget.' },
					{ title: 'Brand Refresh + Renovations', desc: 'Transforming existing spaces with precision and minimal disruption.' },
					{ title: 'Design Build', desc: 'Integrated design and construction under one team — faster delivery, tighter budgets.' },
					{ title: 'Maintenance Programs', desc: 'Custom solutions for unique construction challenges nationwide.' },
				].map((service) => (
					<FadeInSection client:load>
						<div class="p-8 bg-white border-t-4 border-jbs-blue hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{service.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{service.desc}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- ===================== TAGLINE BAND ===================== -->
	<section class="py-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-white/[0.02] rotate-45 translate-x-1/2 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
			<h2 class="font-heading text-5xl md:text-7xl font-900 text-white leading-tight">
				We're Built Different<br/>
				<span class="text-jbs-blue">By Leaders Like You.</span>
			</h2>
			<div class="mt-10">
				<a href="/contact" class="inline-flex items-center px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 hover:shadow-xl hover:shadow-jbs-blue/20 transition-all">
					Let's Connect
				</a>
			</div>
		</div>
	</section>

	<!-- ===================== OUR CREW TEASER ===================== -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-center">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our Crew</p>
						<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark mb-6">
							Real Crews.<br/>Real Sites.<br/>Real Results.
						</h2>
						<p class="text-jbs-charcoal/70 leading-relaxed mb-8 max-w-lg">
							At JBS, our people are our difference. Experienced superintendents, skilled craftsmen, 
							and dedicated project managers working together to deliver exceptional results — every time.
						</p>
						<a href="/about" class="inline-flex items-center font-heading text-sm uppercase tracking-wider text-jbs-blue hover:text-jbs-dark transition-colors group">
							Meet the Team
							<svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
							</svg>
						</a>
					</div>
				</FadeInSection>
				<FadeInSection client:load>
				<div class="aspect-[4/3] bg-jbs-dark flex flex-col items-center justify-center p-12 text-center">
					<span class="font-heading text-6xl font-800 text-white/10 leading-none mb-4">490+</span>
					<span class="font-heading text-xl text-white uppercase tracking-wider">Projects Managed</span>
					<span class="text-white/40 text-sm mt-2">Nationwide</span>
					<div class="mt-8 w-16 h-1 bg-jbs-blue"></div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
