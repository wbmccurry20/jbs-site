---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import PortfolioGrid from '../components/PortfolioGrid';

const pageTitle = "Portfolio | JBS Construction";
const pageDescription = "See our work — ground-up builds, remodels, and multi-site rollouts for national commercial brands.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-1/3 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Our Work</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Portfolio</h1>
					<p class="text-xl text-white/60 max-w-xl">Every project is proof. Here's what Built Different looks like on the ground.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Stats Band -->
	<section class="py-12 bg-jbs-blue">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
				{[
					{ number: '490+', label: 'Projects Managed' },
					{ number: '120+', label: 'Cities Nationwide' },
					{ number: '88+', label: 'Active Projects' },
					{ number: 'E2E', label: 'Project Management' },
				].map((stat) => (
					<div>
						<p class="font-heading text-4xl md:text-5xl font-800 text-white">{stat.number}</p>
						<p class="text-white/70 text-sm mt-1">{stat.label}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Projects Grid -->
	<section class="pt-16 pb-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<PortfolioGrid client:load />
		</div>
	</section>

	<!-- Before / After Spotlight -->
	<section class="py-24 bg-jbs-dark">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Transformation</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-white">Before & After</h2>
					<p class="text-white/30 text-sm mt-4">Drag the slider to compare</p>
				</div>
			</FadeInSection>

			<div class="mb-20">
				<p class="text-center text-white/50 font-heading text-sm uppercase tracking-widest mb-8">Take 5 Oil Change — Conversion · Corpus Christi, TX</p>
				<BeforeAfterSlider
					client:load
					beforeImage="/images/projects/corpus_christi_before.png"
					afterImage="/images/projects/corpus_christi_after.png"
					beforeAlt="Take 5 Oil Change Corpus Christi — Before"
					afterAlt="Take 5 Oil Change Corpus Christi — After"
				/>
			</div>

			<div>
				<p class="text-center text-white/50 font-heading text-sm uppercase tracking-widest mb-8">Mister Car Wash — Brand Refresh · Atlanta, GA</p>
				<BeforeAfterSlider
					client:load
					beforeImage="/images/projects/mister_car_wash_before_ATL.GA.jpg"
					afterImage="/images/projects/mister_car_wash_after_ATL.GA.jpg.jpg"
					beforeAlt="Mister Car Wash Atlanta — Before"
					afterAlt="Mister Car Wash Atlanta — After"
				/>
			</div>
		</div>
	</section>

	<!-- Tagline Band -->
	<section class="py-16 bg-jbs-dark">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<h2 class="font-heading text-4xl md:text-5xl font-800 text-white uppercase tracking-wide">Every Build Tells a Story.</h2>
			<p class="text-white/40 mt-4 text-lg">Yours is next.</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-jbs-cream">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark mb-6">Got a Project?</h2>
				<p class="text-jbs-charcoal/60 text-lg mb-10 max-w-xl mx-auto">Let's talk about how JBS can deliver for your next build.</p>
				<a href="/contact" class="inline-block px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Contact Us</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
