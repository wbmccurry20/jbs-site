---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import BeforeAfterSlider from '../components/BeforeAfterSlider';

const pageTitle = "Portfolio | JBS Construction";
const pageDescription = "See our work — ground-up builds, remodels, and multi-site rollouts for national commercial brands.";

const categories = ['All', 'Ground-Up', 'Conversion', 'Remodels', 'Rollouts'];

const projects = [
	{ title: 'Mister Car Wash', category: 'Ground-Up', location: 'Draper, UT', image: '/images/projects/Draper_1.png' },
	{ title: 'Take 5 Oil Change', category: 'Ground-Up', location: 'Colorado Springs, CO', image: '/images/projects/take5_coSprings.jpg' },
	{ title: 'Take 5 Oil Change', category: 'Conversion', location: 'Corpus Christi, TX', image: '/images/projects/corpussy_after.png' },
	{ title: 'Ray-Corf Recreation Park', category: 'Ground-Up', location: 'Burnsville, NC', image: '/images/projects/rayCort_park.jpg' },
];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-1/3 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Our Work</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Portfolio</h1>
					<p class="text-xl text-white/60 max-w-xl">Every project is proof. Here's what Built Different looks like on the ground.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Stats Band -->
	<section class="py-12 bg-jbs-blue">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
				{[
					{ number: '120+', label: 'Projects Completed' },
					{ number: '88+', label: 'Cities Nationwide' },
					{ number: '490+', label: 'Years Combined Exp.' },
					{ number: 'E2E', label: 'Project Management' },
				].map((stat) => (
					<div>
						<p class="font-heading text-4xl md:text-5xl font-800 text-white">{stat.number}</p>
						<p class="text-white/70 text-sm mt-1">{stat.label}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Filter Tabs (visual only — no JS filter yet) -->
	<section class="pt-16 pb-8 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-wrap gap-3 justify-center">
				{categories.map((cat, i) => (
					<button
						class:list={[
							"px-6 py-2 font-heading text-sm uppercase tracking-wider transition-all",
							i === 0
								? "bg-jbs-dark text-white"
								: "bg-jbs-beige text-jbs-charcoal hover:bg-jbs-dark hover:text-white"
						]}
					>
						{cat}
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Projects Grid -->
	<section class="py-12 pb-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{projects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.08}>
						<div class="group cursor-pointer">
							<div class="aspect-[4/3] bg-jbs-beige relative overflow-hidden mb-4">
								<img
									src={project.image}
									alt={project.title}
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-jbs-dark/0 group-hover:bg-jbs-dark/50 transition-all flex items-center justify-center">
									<span class="text-white font-heading uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all text-sm">View Project</span>
								</div>
							</div>
							<div class="flex items-start justify-between gap-4">
								<div>
									<h3 class="font-heading text-xl text-jbs-dark uppercase">{project.title}</h3>
									<p class="text-jbs-charcoal/50 text-sm">{project.location}</p>
								</div>
								<span class="text-xs font-heading uppercase tracking-wider text-jbs-blue bg-jbs-blue/10 px-3 py-1 shrink-0">{project.category}</span>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Before / After Spotlight -->
	<section class="py-24 bg-jbs-dark">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-12">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Transformation</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-white">Before & After</h2>
					<p class="text-white/50 mt-4 max-w-xl mx-auto">Take 5 Oil Change — Conversion · Corpus Christi, TX</p>
					<p class="text-white/30 text-sm mt-2">Drag the slider to compare</p>
				</div>
			</FadeInSection>
			<BeforeAfterSlider
				client:load
				beforeImage="/images/projects/corpussy_before.png"
				afterImage="/images/projects/corpussy_after.png"
				beforeAlt="Take 5 Oil Change Corpus Christi — Before"
				afterAlt="Take 5 Oil Change Corpus Christi — After"
			/>
		</div>
	</section>

	<!-- Tagline Band -->
	<section class="py-16 bg-jbs-dark">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<h2 class="font-heading text-4xl md:text-5xl font-800 text-white uppercase tracking-wide">Every Build Tells a Story.</h2>
			<p class="text-white/40 mt-4 text-lg">Yours is next.</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-jbs-cream">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark mb-6">Got a Project?</h2>
				<p class="text-jbs-charcoal/60 text-lg mb-10 max-w-xl mx-auto">Let's talk about how JBS can deliver for your next build.</p>
				<a href="/contact" class="inline-block px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Get a Quote</a>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
