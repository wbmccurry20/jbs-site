---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import Footer from '../components/Footer';

const pageTitle = "Our Portfolio | JBS Construction Projects";
const pageDescription = "Browse our portfolio of completed residential construction projects including custom homes, renovations, and additions in Western North Carolina.";

const projects = [
	{
		id: 1,
		title: 'Modern Mountain Retreat',
		location: 'Asheville, NC',
		category: 'New Construction',
		year: '2025',
		sqft: '3,200 sq ft',
		image: 'https://placehold.co/800x600/004E89/ffffff?text=Modern+Mountain+Retreat',
		description: 'A stunning contemporary home featuring floor-to-ceiling windows, sustainable materials, and smart home integration. Built to passive house standards.',
		features: ['Solar panels', 'Rainwater collection', 'Geothermal heating', 'Smart home system'],
	},
	{
		id: 2,
		title: 'Historic Craftsman Revival',
		location: 'Boone, NC',
		category: 'Renovation',
		year: '2024',
		sqft: '2,800 sq ft',
		image: 'https://placehold.co/800x600/F7C548/1A1A2E?text=Historic+Craftsman',
		description: 'Complete restoration of a 1920s craftsman home, preserving original character while adding modern amenities and energy efficiency.',
		features: ['Original hardwood restored', 'Updated electrical/plumbing', 'Energy-efficient windows', 'Modern kitchen'],
	},
	{
		id: 3,
		title: 'Family Addition',
		location: 'Blowing Rock, NC',
		category: 'Addition',
		year: '2024',
		sqft: '1,500 sq ft',
		image: 'https://placehold.co/800x600/FF6B35/ffffff?text=Family+Addition',
		description: 'Two-bedroom second-story addition with master suite and home office, seamlessly matching the existing home\'s architecture.',
		features: ['Two bedrooms', 'Master bathroom', 'Home office', 'Deck expansion'],
	},
	{
		id: 4,
		title: 'Luxury Kitchen Remodel',
		location: 'Asheville, NC',
		category: 'Renovation',
		year: '2025',
		sqft: '450 sq ft',
		image: 'https://placehold.co/800x600/4A5568/ffffff?text=Luxury+Kitchen',
		description: 'High-end kitchen transformation with custom cabinetry, premium appliances, and open concept design.',
		features: ['Custom cabinets', 'Quartz countertops', 'Professional appliances', 'Smart lighting'],
	},
	{
		id: 5,
		title: 'Outdoor Living Paradise',
		location: 'Hendersonville, NC',
		category: 'Outdoor',
		year: '2024',
		sqft: '800 sq ft',
		image: 'https://placehold.co/800x600/004E89/ffffff?text=Outdoor+Living',
		description: 'Complete outdoor entertainment space with covered deck, outdoor kitchen, fire pit, and landscaping.',
		features: ['Covered deck', 'Outdoor kitchen', 'Fire pit', 'Professional landscaping'],
	},
	{
		id: 6,
		title: 'Net-Zero Green Home',
		location: 'Banner Elk, NC',
		category: 'New Construction',
		year: '2025',
		sqft: '2,500 sq ft',
		image: 'https://placehold.co/800x600/22C55E/ffffff?text=Net+Zero+Green+Home',
		description: 'LEED Platinum certified home producing as much energy as it consumes through solar and advanced building techniques.',
		features: ['Net-zero energy', 'LEED Platinum', 'Triple-pane windows', 'Recycled materials'],
	},
];

const categories = ['All', 'New Construction', 'Renovation', 'Addition', 'Outdoor'];
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero Section -->
	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-accent/20 text-construction-accent font-semibold rounded-full mb-6">
						Our Work
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						<span class="block text-construction-primary">Portfolio</span>
					</h1>
					<p class="text-xl text-gray-300">
						Explore our completed projects across Western North Carolina. 
						From custom homes to complete renovations, see the quality and craftsmanship we deliver.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Filter Section (Static for now - can be made interactive later) -->
	<section class="py-12 bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-wrap gap-3 justify-center">
				{categories.map((category) => (
					<button class={`px-6 py-2 rounded-full font-semibold transition-all ${
						category === 'All'
							? 'bg-construction-primary text-white'
							: 'bg-white text-construction-dark hover:bg-construction-primary/10'
					}`}>
						{category}
					</button>
				))}
			</div>
		</div>
	</section>

	<!-- Projects Grid -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{projects.map((project, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all group">
							<div class="relative h-64 bg-gradient-to-br from-construction-steel to-construction-secondary overflow-hidden">
								<div class="absolute inset-0 flex items-center justify-center text-white text-6xl opacity-20">
									{project.category === 'New Construction' && '🏗️'}
									{project.category === 'Renovation' && '🔨'}
									{project.category === 'Addition' && '📐'}
									{project.category === 'Outdoor' && '🌳'}
								</div>
								<div class="absolute top-4 right-4">
									<span class="px-3 py-1 bg-construction-accent text-construction-dark rounded-full text-sm font-semibold">
										{project.category}
									</span>
								</div>
							</div>
							
							<div class="p-6">
								<h3 class="text-2xl font-display font-bold text-construction-dark mb-2 group-hover:text-construction-primary transition-colors">
									{project.title}
								</h3>
								<div class="flex items-center text-gray-700 text-sm mb-4">
									<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
									{project.location}
									<span class="mx-2">•</span>
									{project.year}
								</div>
								
								<p class="text-gray-700 mb-4 line-clamp-3">
									{project.description}
								</p>
								
								<div class="mb-4">
									<div class="text-sm font-semibold text-construction-dark mb-2">Key Features:</div>
									<div class="flex flex-wrap gap-2">
										{project.features.slice(0, 3).map((feature) => (
											<span class="text-xs px-2 py-1 bg-construction-primary/10 text-construction-primary rounded">
												{feature}
											</span>
										))}
									</div>
								</div>
								
								<div class="pt-4 border-t border-gray-200 flex justify-between items-center">
									<div class="text-sm text-gray-700">
										<span class="font-semibold text-construction-dark">{project.sqft}</span>
									</div>
									<button class="text-construction-primary font-semibold hover:underline">
										View Details →
									</button>
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Before/After Section -->
	<section class="py-20 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-12">
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Transformation Gallery
					</h2>
					<p class="text-xl text-gray-700">
						See the dramatic difference our work makes
					</p>
				</div>
			</FadeInSection>

			<div class="space-y-12">
				<FadeInSection client:load delay={0.2}>
					<div>
						<h3 class="text-2xl font-display font-bold text-construction-dark mb-4">
							Historic Home Renovation - Boone, NC
						</h3>
						<BeforeAfterSlider
							client:load
						beforeImage="https://placehold.co/1200x800/8B7355/ffffff?text=Before+-+Historic+Home"
						afterImage="https://placehold.co/1200x800/F7C548/1A1A2E?text=After+-+Restored+Beauty"
							beforeAlt="Historic home before renovation"
							afterAlt="Historic home after renovation"
						/>
					</div>
				</FadeInSection>

				<FadeInSection client:load delay={0.3}>
					<div>
						<h3 class="text-2xl font-display font-bold text-construction-dark mb-4">
							Kitchen Remodel - Asheville, NC
						</h3>
						<BeforeAfterSlider
							client:load
						beforeImage="https://placehold.co/1200x800/D4C4B0/ffffff?text=Before+-+Dated+Kitchen"
						afterImage="https://placehold.co/1200x800/FF6B35/ffffff?text=After+-+Modern+Kitchen"
							beforeAlt="Kitchen before remodel"
							afterAlt="Kitchen after remodel"
						/>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Stats Section -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-12">
					<div class="inline-block px-4 py-2 bg-construction-primary/20 text-construction-primary font-semibold rounded-full mb-4">
						By The Numbers
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Our Track Record
					</h2>
					<p class="text-xl text-gray-700">
						Numbers that speak to our experience and quality
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ number: '500+', label: 'Projects Completed', icon: '🏗️' },
					{ number: '20+', label: 'Years Experience', icon: '📅' },
					{ number: '98%', label: 'Client Satisfaction', icon: '⭐' },
					{ number: '$150M+', label: 'Total Project Value', icon: '💰' },
				].map((stat, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="text-center">
							<div class="text-6xl mb-4">{stat.icon}</div>
							<div class="text-5xl font-bold text-construction-primary mb-2">
								{stat.number}
							</div>
						<div class="text-gray-700 font-semibold">{stat.label}</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-6">
					Ready to Add Your Project to Our Portfolio?
				</h2>
				<p class="text-xl text-gray-300 mb-8">
					Let's create something amazing together. Get started with a free consultation.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white rounded-lg font-semibold text-lg hover:bg-construction-accent hover:text-construction-dark hover:shadow-2xl hover:scale-105 transition-all"
					>
						Start Your Project
					</a>
					<a
						href="/services"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent rounded-lg font-semibold text-lg hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						View Services
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
