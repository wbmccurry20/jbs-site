---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Contact | JBS Construction";
const pageDescription = "Get in touch with JBS Construction. Request a quote, ask a question, or start your next commercial build.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Get in Touch</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Let's Build</h1>
					<p class="text-xl text-white/60 max-w-xl">Ready to start your next project? We'd love to hear from you.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Contact Content -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-5 gap-16">
				
				<!-- Form -->
				<div class="lg:col-span-3">
					<FadeInSection client:load>
						<h2 class="font-heading text-4xl font-800 text-jbs-dark mb-2">Request a Quote</h2>
						<p class="text-jbs-charcoal/60 mb-8">Fill out the form and our team will get back to you within one business day.</p>
						
						<form class="space-y-6" action="#" method="POST">
							<div class="grid md:grid-cols-2 gap-6">
								<div>
									<label for="name" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Full Name</label>
									<input type="text" id="name" name="name" required
										class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark" />
								</div>
								<div>
									<label for="company" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Company</label>
									<input type="text" id="company" name="company"
										class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark" />
								</div>
							</div>
							<div class="grid md:grid-cols-2 gap-6">
								<div>
									<label for="email" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Email</label>
									<input type="email" id="email" name="email" required
										class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark" />
								</div>
								<div>
									<label for="phone" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Phone</label>
									<input type="tel" id="phone" name="phone"
										class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark" />
								</div>
							</div>
							<div>
								<label for="service" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Service Needed</label>
								<select id="service" name="service"
									class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark">
									<option value="">Select a service...</option>
									<option value="ground-up">Ground-Up Construction</option>
									<option value="remodel">Remodel / Renovation</option>
									<option value="maintenance">Maintenance Program</option>
									<option value="tenant-improvement">Tenant Improvement</option>
									<option value="rollout">National Rollout</option>
									<option value="other">Other</option>
								</select>
							</div>
							<div>
								<label for="message" class="block font-heading text-xs uppercase tracking-wider text-jbs-charcoal mb-2">Tell Us About Your Project</label>
								<textarea id="message" name="message" rows="5"
									class="w-full px-4 py-3 bg-jbs-cream border border-jbs-beige focus:border-jbs-blue focus:outline-none transition-colors font-body text-jbs-dark resize-none"></textarea>
							</div>
							<button type="submit"
								class="px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all w-full md:w-auto">
								Send Message
							</button>
						</form>
					</FadeInSection>
				</div>

				<!-- Sidebar -->
				<div class="lg:col-span-2">
					<FadeInSection client:load delay={0.2}>
						<div class="space-y-10">
							<!-- Contact Info -->
							<div>
								<h3 class="font-heading text-2xl text-jbs-dark uppercase mb-6">Contact Info</h3>
								<div class="space-y-4">
									<div>
										<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-1">Email</p>
										<a href="mailto:info@jbsconstructiongroup.com" class="text-jbs-charcoal hover:text-jbs-blue transition-colors">info@jbsconstructiongroup.com</a>
									</div>
									<div>
										<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-1">Phone</p>
										<p class="text-jbs-charcoal">(555) 000-0000</p>
									</div>
									<div>
										<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-1">Headquarters</p>
										<p class="text-jbs-charcoal">City, State</p>
									</div>
								</div>
							</div>

							<!-- Coverage -->
							<div class="bg-jbs-dark p-8">
								<h3 class="font-heading text-xl text-white uppercase mb-4">Nationwide Coverage</h3>
								<p class="text-white/60 text-sm leading-relaxed mb-4">We build in 88+ cities across the United States. Wherever your next project lands, we've got boots on the ground.</p>
								<a href="/services" class="inline-block text-jbs-blue font-heading text-sm uppercase tracking-wider hover:text-jbs-blue/80 transition-colors">View Our Services &rarr;</a>
							</div>

							<!-- Quick Response -->
							<div class="border border-jbs-beige p-8">
								<h3 class="font-heading text-xl text-jbs-dark uppercase mb-4">Quick Response</h3>
								<p class="text-jbs-charcoal/60 text-sm leading-relaxed">We respond to all inquiries within one business day. For urgent matters, call us directly.</p>
							</div>
						</div>
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
