---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "Contact | JBS Construction";
const pageDescription = "Get in touch with JBS Construction. Reach out for your next commercial build.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">Get in Touch</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Let's Build</h1>
					<p class="text-xl text-white/60 max-w-xl">Ready to start your next project? We'd love to hear from you.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Contact Content -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mx-auto">
				<FadeInSection client:load>
					<h2 class="font-heading text-4xl font-800 text-jbs-dark mb-2">Contact Us</h2>
					<p class="text-jbs-charcoal/60 mb-12">Reach out to us directly — we'd love to hear about your next project.</p>

					<div class="grid md:grid-cols-3 gap-10">
						<!-- Address -->
						<div class="text-center">
							<div class="w-14 h-14 bg-jbs-blue/10 flex items-center justify-center mx-auto mb-4">
								<svg class="w-6 h-6 text-jbs-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
							</div>
							<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-2">Address</p>
							<p class="text-jbs-charcoal">City, State</p>
						</div>

						<!-- Phone -->
						<div class="text-center">
							<div class="w-14 h-14 bg-jbs-blue/10 flex items-center justify-center mx-auto mb-4">
								<svg class="w-6 h-6 text-jbs-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
							</div>
							<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-2">Phone</p>
							<a href="tel:+15550000000" class="text-jbs-charcoal hover:text-jbs-blue transition-colors">(555) 000-0000</a>
						</div>

						<!-- Email -->
						<div class="text-center">
							<div class="w-14 h-14 bg-jbs-blue/10 flex items-center justify-center mx-auto mb-4">
								<svg class="w-6 h-6 text-jbs-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
							</div>
							<p class="font-heading text-xs uppercase tracking-wider text-jbs-blue mb-2">Email</p>
							<a href="mailto:info@jbsconstructiongroup.com" class="text-jbs-charcoal hover:text-jbs-blue transition-colors">info@jbsconstructiongroup.com</a>
						</div>
					</div>

					<!-- Nationwide Coverage -->
					<div class="mt-16 bg-jbs-dark p-10 text-center">
						<h3 class="font-heading text-2xl text-white uppercase mb-4">Nationwide Coverage</h3>
						<p class="text-white/60 leading-relaxed mb-6 max-w-lg mx-auto">We build in 88+ cities across the United States. Wherever your next project lands, we've got boots on the ground.</p>
						<a href="/services" class="inline-block text-jbs-blue font-heading text-sm uppercase tracking-wider hover:text-jbs-blue/80 transition-colors">View Our Services &rarr;</a>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
