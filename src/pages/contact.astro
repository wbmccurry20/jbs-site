---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';
import ContactForm from '../components/ContactForm';

const pageTitle = "Contact JBS Construction | Let's Connect";
const pageDescription = "Ready to discuss your commercial construction project? Contact JBS Construction for a consultation. Serving clients nationwide.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero Section -->
	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black relative">
		<!-- Blue Glow Overlay -->
		<div class="absolute inset-0 bg-construction-primary/15 mix-blend-overlay pointer-events-none"></div>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-primary/20 text-construction-primary font-semibold rounded-full mb-6">
						Get In Touch
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						Let's <span class="text-construction-primary">Connect</span>
					</h1>
					<p class="text-xl text-gray-300">
						Questions about JBS Construction? We'd love to hear from you.
						Reach out using the contact information below.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Contact Section -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12">
				<!-- Contact Form -->
				<FadeInSection client:load>
					<div class="bg-white rounded-2xl shadow-2xl p-8">
						<h2 class="text-3xl font-display font-bold text-construction-dark mb-2">
							<span class="text-construction-primary">Contact</span> Us
						</h2>
						<p class="text-gray-700 mb-8">
							Fill out the form below and we'll get back to you within 24 hours.
						</p>
						<ContactForm client:load />
					</div>
				</FadeInSection>

				<!-- Contact Information -->
				<div class="space-y-8">
					<FadeInSection client:load delay={0.2}>
						<div>
							<h3 class="text-2xl font-display font-bold text-construction-dark mb-6">
								Get in Touch
							</h3>
							<div class="space-y-6">
								<!-- Phone -->
								<div class="flex items-start space-x-4">
									<div class="w-12 h-12 bg-construction-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
										<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
										</svg>
									</div>
									<div>
										<h4 class="font-semibold text-construction-dark mb-1">Phone</h4>
										<a href="tel:+18285550123" class="text-construction-primary hover:underline">
											(828) 555-0123
										</a>
										<p class="text-sm text-gray-700 mt-1">
											Mon-Fri: 8am-6pm<br />Sat: 9am-4pm
										</p>
									</div>
								</div>

								<!-- Email -->
								<div class="flex items-start space-x-4">
									<div class="w-12 h-12 bg-construction-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
										<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
										</svg>
									</div>
									<div>
										<h4 class="font-semibold text-construction-dark mb-1">Email</h4>
										<a href="mailto:info@abconstruction.com" class="text-construction-primary hover:underline">
											info@abconstruction.com
										</a>
										<p class="text-sm text-gray-700 mt-1">
											We respond within 24 hours
										</p>
									</div>
								</div>

								<!-- Address -->
								<div class="flex items-start space-x-4">
									<div class="w-12 h-12 bg-construction-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
										<svg class="w-6 h-6 text-construction-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
										</svg>
									</div>
									<div>
										<h4 class="font-semibold text-construction-dark mb-1">Office</h4>
										<p class="text-gray-700">
											123 Main Street<br />
											Asheville, NC 28801
										</p>
										<a href="#" class="text-construction-primary text-sm hover:underline mt-2 inline-block">
											Get Directions →
										</a>
									</div>
								</div>
							</div>
						</div>
					</FadeInSection>

					<FadeInSection client:load delay={0.3}>
						<div class="bg-gradient-to-br from-construction-primary to-construction-accent rounded-2xl p-8 text-white">
							<h3 class="text-2xl font-display font-bold mb-4">
								Emergency Services
							</h3>
							<p class="mb-6 text-white/90">
								Have an urgent construction emergency? We're here to help 24/7.
							</p>
							<a
								href="tel:+18285550123"
								class="inline-flex items-center px-6 py-3 bg-white text-construction-primary rounded-lg font-semibold hover:shadow-lg transition-all"
							>
								<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
								Call Emergency Line
							</a>
						</div>
					</FadeInSection>

					<FadeInSection client:load delay={0.4}>
						<div class="bg-white rounded-2xl p-8 shadow-lg">
							<h3 class="text-xl font-display font-bold text-construction-dark mb-4">
								Service Areas
							</h3>
							<div class="grid grid-cols-2 gap-3 text-gray-700">
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Asheville
								</div>
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Boone
								</div>
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Blowing Rock
								</div>
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Hendersonville
								</div>
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Brevard
								</div>
								<div class="flex items-center">
									<svg class="w-4 h-4 text-construction-primary mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
									Banner Elk
								</div>
							</div>
							<p class="text-sm text-gray-700 mt-4">
								Don't see your area? Contact us - we may still be able to help!
							</p>
						</div>
					</FadeInSection>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-20 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-12">
					<h2 class="text-4xl font-display font-bold text-construction-dark mb-4">
						Common Questions
					</h2>
					<p class="text-xl text-gray-700">
						Quick answers to help you get started
					</p>
				</div>
			</FadeInSection>

			<div class="space-y-6">
				{[
					{
						q: "How quickly can you start my project?",
						a: "Our timeline varies based on project scope and current schedule. Typically, we can begin planning within 1-2 weeks of initial consultation. Construction start dates depend on permits, materials, and weather conditions."
					},
					{
						q: "Do you offer free estimates?",
						a: "Yes! We provide free, no-obligation consultations and estimates. After an initial site visit and discussion of your needs, we'll provide a detailed proposal within 3-5 business days."
					},
					{
						q: "Are you licensed and insured?",
						a: "Absolutely. We're fully licensed, bonded, and insured in North Carolina. We carry comprehensive liability and workers' compensation insurance for your protection."
					},
					{
						q: "What areas do you serve?",
						a: "We primarily serve Western North Carolina, including Asheville, Boone, Blowing Rock, Hendersonville, Brevard, and Banner Elk. Contact us if you're outside these areas."
					},
				].map((faq, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<details class="bg-construction-light rounded-lg p-6 group">
							<summary class="font-semibold text-construction-dark cursor-pointer list-none flex items-center justify-between">
								{faq.q}
								<svg class="w-5 h-5 text-construction-primary group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<p class="mt-4 text-gray-700">
								{faq.a}
							</p>
						</details>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<Footer />
</Layout>
