---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About JBS Construction | Built Different";
const pageDescription = "Learn about JBS Construction — nationwide commercial construction built on accountability, communication, and operational excellence.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-white/[0.02] rotate-45 -translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">About Us</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Our Crew</h1>
					<p class="text-xl text-white/60 max-w-xl">Real people. Real accountability. Real results — in every city we build.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- What We Believe -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">What We Believe</p>
						<h2 class="font-heading text-5xl font-800 text-jbs-dark mb-8">Building Shouldn't<br/>Be Complicated.</h2>
						<div class="space-y-4 text-jbs-charcoal/80 leading-relaxed">
							<p>That communication shouldn't require chasing. That every project deserves a leader who owns the outcome.</p>
							<p>We believe in solving problems — fast. In being honest — even when it's hard. In doing the right thing — even when no one's watching.</p>
							<p>We believe people matter. Our teams. Our clients. Our subs. Everyone. Take care of people, and the work takes care of itself.</p>
							<p>We believe in new ways of building — smarter systems, better visibility, less red tape, more results.</p>
						</div>
					</div>
				</FadeInSection>
				<FadeInSection client:load>
					<div class="bg-jbs-dark p-12">
						<h3 class="font-heading text-3xl text-white uppercase mb-6">Our Promise</h3>
						<div class="space-y-4 text-white/70 leading-relaxed">
							<p>We're committed to making commercial construction clearer, easier, and faster for our national brand partners.</p>
							<p>Every project receives dedicated project management, proactive communication, and the accountability you deserve.</p>
						</div>
						<div class="mt-8 pt-8 border-t border-white/10">
							<p class="font-heading text-2xl text-jbs-blue uppercase">Built Different. Because we are built different.</p>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Core Values -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">What Drives Us</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Core Values</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{[
					{ title: 'Accountability + Ownership', description: 'Every project has a leader. Every client has a champion. Every detail has an owner.' },
					{ title: 'Proactive Communication', description: 'Clear, consistent updates — so clients always know what\'s happening, what\'s next, and what\'s needed.' },
					{ title: 'Operational Excellence', description: 'Streamlined systems, repeatable processes, and fast, adaptive workflows.' },
					{ title: 'Relationship-First Leadership', description: 'We solve problems, not point fingers. We invest in people — clients, teams, and partners.' },
					{ title: 'Build + Maintain', description: 'One partner for new builds, remodels, and maintenance — creating efficiency and consistency across every site.' },
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-jbs-blue hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{value.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{value.description}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Team Placeholder -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Leadership</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Meet the Team</h2>
				</div>
			</FadeInSection>
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				{[1, 2, 3, 4].map((i) => (
					<FadeInSection client:load>
						<div class="text-center">
							<div class="aspect-square bg-jbs-beige mb-4 flex items-center justify-center">
								<span class="text-jbs-gray font-heading text-xs uppercase tracking-widest">Photo</span>
							</div>
							<h3 class="font-heading text-lg text-jbs-dark uppercase">Team Member</h3>
							<p class="text-jbs-charcoal/50 text-sm">Title Placeholder</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-jbs-blue/[0.05] rotate-45 -translate-x-1/2 translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Let's Build Together</h2>
				<div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
					<a href="/contact" class="px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Get Started</a>
					<a href="/portfolio" class="px-10 py-4 border-2 border-white/20 text-white font-heading text-lg uppercase tracking-wider hover:border-jbs-blue hover:text-jbs-blue transition-all">See Our Work</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
