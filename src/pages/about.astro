---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About JBS Construction | Our Story";
const pageDescription = "Learn about JBS Construction's 20+ year history building custom homes and renovations in Western North Carolina. Meet our team and discover our values.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero Section -->
	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black relative">
		<!-- Blue Glow Overlay -->
		<div class="absolute inset-0 bg-construction-primary/15 mix-blend-overlay pointer-events-none"></div>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-accent/20 text-construction-accent font-semibold rounded-full mb-6">
						Built Different
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						We're <span class="text-construction-primary">JBS</span>
					</h1>
					<p class="text-xl text-gray-300">
						Believe in Built Different.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Our Story -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<FadeInSection client:load>
					<div>
						<h2 class="text-4xl font-display font-bold text-construction-dark mb-6">
							What We <span class="text-construction-primary">Believe</span>
						</h2>
						<div class="space-y-4 text-gray-700 text-lg">
							<p>
								We believe building shouldn't be complicated.<br />
								That communication shouldn't require chasing.<br />
								That every project deserves a leader who owns the outcome.
							</p>
							<p>
								We believe in solving problems - fast.<br />
								In being honest - even when it's hard.<br />
								In doing the right thing - even when no one's watching.
							</p>
							<p>
								We believe people matter.<br />
								Our teams. Our clients. Our subs. Everyone.<br />
								Take care of people, and the work takes care of itself.
							</p>
							<p>
								We believe in new ways of building -<br />
								Smarter systems. Better visibility.<br />
								Less red tape. More results.
							</p>
							<p>
								Because construction shouldn't feel old school.<br />
								And managing your facilities shouldn't feel chaotic.
							</p>
							<p class="text-construction-dark font-semibold text-xl">
								We're here to make it all clearer, easier, and faster.<br />
								To build differently - because we are built differently.
							</p>
						</div>
					</div>
				</FadeInSection>

				<FadeInSection client:load delay={0.2}>
					<div class="bg-gradient-to-br from-construction-primary to-construction-accent rounded-2xl p-12 text-white">
						<h3 class="text-3xl font-display font-bold mb-6">Our Promise</h3>
						<div class="space-y-4 text-lg">
							<p>
								We're committed to making commercial construction clearer, easier, and faster for our national brand partners.
							</p>
							<p>
								Every project receives dedicated project management, proactive communication, and the accountability you deserve.
							</p>
							<p class="text-2xl font-semibold mt-6">
								Built Different. Because we are built different.
							</p>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Our Values -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<div class="inline-block px-4 py-2 bg-construction-primary/10 text-construction-primary font-semibold rounded-full mb-4">
						What Drives Us
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Our Core <span class="text-construction-primary">Values</span>
					</h2>
					<p class="text-xl text-gray-700 max-w-3xl mx-auto">
						These principles guide every decision we make and every project we undertake.
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{[
					{
						icon: '✓',
						title: 'Accountability + Ownership',
						description: 'Every project has a leader. Every client has a champion. Every detail has an owner.',
					},
					{
						icon: '💬',
						title: 'Proactive Communication',
						description: 'Clear, consistent updates - so clients always know what\'s happening, what\'s next and what\'s needed.',
					},
					{
						icon: '⚙️',
						title: 'Operational Excellence',
						description: 'Streamlined systems, repeatable processes, and fast, adaptive workflows - built around how modern "boxes" get delivered.',
					},
					{
						icon: '🤝',
						title: 'Relationship-First Leadership',
						description: 'We solve problems, not point fingers. We invest in people - clients, teams, and partners - because strong relationships build better outcomes.',
					},
					{
						icon: '🏗️',
						title: 'Build + Maintain',
						description: 'One partner for new builds, remodels, and maintenance - creating efficiency and consistency across every site and every project.',
					},
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-shadow">
							<div class="text-6xl mb-4">{value.icon}</div>
							<h3 class="text-2xl font-display font-bold text-construction-dark mb-3">
								{value.title}
							</h3>
							<p class="text-gray-700">
								{value.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Certifications & Partnerships -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<div class="inline-block px-4 py-2 bg-construction-primary/20 text-construction-primary font-semibold rounded-full mb-4">
						Trusted & Certified
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Certifications & <span class="text-construction-primary">Memberships</span>
					</h2>
					<p class="text-xl text-gray-700">
						Proud members of industry-leading organizations
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ name: 'NC Licensed General Contractor', abbr: 'NCLGC' },
					{ name: 'LEED Accredited Professional', abbr: 'LEED AP' },
					{ name: 'National Association of Home Builders', abbr: 'NAHB' },
					{ name: 'Better Business Bureau A+ Rating', abbr: 'BBB A+' },
				].map((cert, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-construction-light border-2 border-construction-primary/20 rounded-xl p-6 text-center hover:border-construction-primary/40 hover:shadow-lg transition-all">
							<div class="text-4xl font-bold text-construction-primary mb-2">
								{cert.abbr}
							</div>
							<div class="text-sm text-gray-700 font-semibold">
								{cert.name}
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black relative">
		<!-- Blue Glow Overlay -->
		<div class="absolute inset-0 bg-construction-primary/15 mix-blend-overlay pointer-events-none"></div>
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-6">
					Let's Build <span class="text-construction-primary">Something Together</span>
				</h2>
				<p class="text-xl text-gray-300 mb-8">
					Experience the JBS Construction difference. Schedule your free consultation today.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white rounded-lg font-semibold text-lg hover:bg-blue-600 hover:shadow-2xl hover:scale-105 transition-all"
					>
						Get Started
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-primary text-construction-primary rounded-lg font-semibold text-lg hover:bg-construction-primary hover:text-white transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
