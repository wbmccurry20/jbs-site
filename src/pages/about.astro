---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About JBS Construction | Our Story";
const pageDescription = "Learn about JBS Construction's 20+ year history building custom homes and renovations in Western North Carolina. Meet our team and discover our values.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero Section -->
	<section class="pt-32 pb-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center max-w-3xl mx-auto">
					<div class="inline-block px-4 py-2 bg-construction-accent/20 text-construction-accent font-semibold rounded-full mb-6">
						Our Story
					</div>
					<h1 class="text-5xl md:text-6xl font-display font-bold mb-6 text-white">
						About <span class="text-construction-primary">JBS Construction</span>
					</h1>
					<p class="text-xl text-gray-300">
						Building dreams and lasting relationships in Western North Carolina since 2004.
					</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- Our Story -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<FadeInSection client:load>
					<div>
						<h2 class="text-4xl font-display font-bold text-construction-dark mb-6">
							Our Story
						</h2>
						<div class="space-y-4 text-gray-700 text-lg">
							<p>
								JBS Construction was founded in 2004 by brothers Andrew and Benjamin Walker, 
								who grew up in the mountains of Western North Carolina with a deep appreciation 
								for quality craftsmanship and sustainable building practices.
							</p>
							<p>
								What started as a two-person operation building custom decks has grown into 
								a full-service residential construction company with over 30 skilled craftsmen, 
								designers, and project managers. Yet we've never lost sight of our core values: 
								quality, integrity, and personal service.
							</p>
							<p>
								Over the past 20 years, we've completed more than 500 projects throughout 
								Western North Carolina, from new custom homes to historic renovations. 
								Each project is a testament to our commitment to excellence and our passion 
								for creating spaces where families thrive.
							</p>
							<p>
								Today, we're proud to be one of the region's leading construction companies, 
								known for our innovative approach, sustainable practices, and unwavering 
								dedication to client satisfaction.
							</p>
						</div>
					</div>
				</FadeInSection>

				<FadeInSection client:load delay={0.2}>
					<div class="bg-gradient-to-br from-construction-primary to-construction-accent rounded-2xl p-12 text-white">
						<h3 class="text-3xl font-display font-bold mb-6">By the Numbers</h3>
						<div class="space-y-6">
							<div class="flex items-center">
								<div class="text-5xl font-bold mr-6">20+</div>
								<div>
									<div class="font-semibold">Years in Business</div>
									<div class="text-white/80 text-sm">Established 2004</div>
								</div>
							</div>
							<div class="flex items-center">
								<div class="text-5xl font-bold mr-6">500+</div>
								<div>
									<div class="font-semibold">Projects Completed</div>
									<div class="text-white/80 text-sm">And counting</div>
								</div>
							</div>
							<div class="flex items-center">
								<div class="text-5xl font-bold mr-6">30+</div>
								<div>
									<div class="font-semibold">Team Members</div>
									<div class="text-white/80 text-sm">Skilled professionals</div>
								</div>
							</div>
							<div class="flex items-center">
								<div class="text-5xl font-bold mr-6">98%</div>
								<div>
									<div class="font-semibold">Client Satisfaction</div>
									<div class="text-white/80 text-sm">Proven track record</div>
								</div>
							</div>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Our Values -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<div class="inline-block px-4 py-2 bg-construction-primary/10 text-construction-primary font-semibold rounded-full mb-4">
						What Drives Us
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Our Core Values
					</h2>
					<p class="text-xl text-gray-700 max-w-3xl mx-auto">
						These principles guide every decision we make and every project we undertake.
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						icon: '🎯',
						title: 'Quality First',
						description: 'We never compromise on quality. Every project receives our full attention to detail and commitment to excellence.',
					},
					{
						icon: '🤝',
						title: 'Integrity Always',
						description: 'Honest communication, transparent pricing, and ethical business practices are non-negotiable for us.',
					},
					{
						icon: '♻️',
						title: 'Sustainable Building',
						description: 'We\'re committed to eco-friendly practices, energy-efficient designs, and reducing our environmental impact.',
					},
					{
						icon: '🏡',
						title: 'Client-Focused',
						description: 'Your vision, your budget, your timeline. We work for you and keep you involved every step of the way.',
					},
					{
						icon: '🔧',
						title: 'Innovation',
						description: 'We embrace modern technology and techniques while respecting traditional craftsmanship.',
					},
					{
						icon: '🌟',
						title: 'Community Impact',
						description: 'As locals, we care about our community and give back through volunteer work and local partnerships.',
					},
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition-shadow">
							<div class="text-6xl mb-4">{value.icon}</div>
							<h3 class="text-2xl font-display font-bold text-construction-dark mb-3">
								{value.title}
							</h3>
							<p class="text-gray-700">
								{value.description}
							</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Team Section -->
	<section class="py-20 bg-construction-light">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<div class="inline-block px-4 py-2 bg-construction-secondary/10 text-construction-secondary font-semibold rounded-full mb-4">
						Meet The Team
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Meet Our Leadership
					</h2>
					<p class="text-xl text-gray-700">
						The experienced team guiding JBS Construction's vision
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						name: 'Andrew Walker',
						role: 'Co-Founder & CEO',
						bio: '20+ years of construction experience. Specializes in sustainable building and project management.',
						credentials: 'Licensed General Contractor, LEED AP',
					},
					{
						name: 'Benjamin Walker',
						role: 'Co-Founder & COO',
						bio: 'Master craftsman with expertise in historic restoration and custom carpentry.',
						credentials: 'Licensed General Contractor, Master Carpenter',
					},
					{
						name: 'Sarah Martinez',
						role: 'Design Director',
						bio: 'Award-winning architect bringing innovative designs to life for 15 years.',
						credentials: 'Licensed Architect, AIA Member',
					},
				].map((member, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-construction-light rounded-xl overflow-hidden hover:shadow-xl transition-shadow">
							<div class="h-64 bg-gradient-to-br from-construction-steel to-construction-secondary flex items-center justify-center">
								<div class="text-8xl text-white/30">👤</div>
							</div>
							<div class="p-6">
								<h3 class="text-2xl font-display font-bold text-construction-dark mb-1">
									{member.name}
								</h3>
								<div class="text-construction-primary font-semibold mb-4">
									{member.role}
								</div>
								<p class="text-gray-700 mb-4">
									{member.bio}
								</p>
								<div class="text-sm text-gray-700 italic">
									{member.credentials}
								</div>
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Certifications & Partnerships -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<div class="inline-block px-4 py-2 bg-construction-primary/20 text-construction-primary font-semibold rounded-full mb-4">
						Trusted & Certified
					</div>
					<h2 class="text-4xl md:text-5xl font-display font-bold text-construction-dark mb-4">
						Certifications & Memberships
					</h2>
					<p class="text-xl text-gray-700">
						Proud members of industry-leading organizations
					</p>
				</div>
			</FadeInSection>

			<div class="grid md:grid-cols-4 gap-8">
				{[
					{ name: 'NC Licensed General Contractor', abbr: 'NCLGC' },
					{ name: 'LEED Accredited Professional', abbr: 'LEED AP' },
					{ name: 'National Association of Home Builders', abbr: 'NAHB' },
					{ name: 'Better Business Bureau A+ Rating', abbr: 'BBB A+' },
				].map((cert, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-construction-light border-2 border-construction-primary/20 rounded-xl p-6 text-center hover:border-construction-primary/40 hover:shadow-lg transition-all">
							<div class="text-4xl font-bold text-construction-primary mb-2">
								{cert.abbr}
							</div>
							<div class="text-sm text-gray-700 font-semibold">
								{cert.name}
							</div>
						</div>
					</FadeInSection>
				))}
			</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-br from-construction-secondary via-construction-dark to-black">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<FadeInSection client:load>
				<h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-6">
					Let's Build Something Together
				</h2>
				<p class="text-xl text-gray-300 mb-8">
					Experience the JBS Construction difference. Schedule your free consultation today.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="px-8 py-4 bg-construction-primary text-white rounded-lg font-semibold text-lg hover:bg-construction-accent hover:text-construction-dark hover:shadow-2xl hover:scale-105 transition-all"
					>
						Get Started
					</a>
					<a
						href="/portfolio"
						class="px-8 py-4 border-2 border-construction-accent text-construction-accent rounded-lg font-semibold text-lg hover:bg-construction-accent hover:text-construction-dark transition-all"
					>
						See Our Work
					</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
