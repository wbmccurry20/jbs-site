---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import FadeInSection from '../components/FadeInSection';
import Footer from '../components/Footer';

const pageTitle = "About JBS Construction | Built Different";
const pageDescription = "Learn about JBS Construction — nationwide commercial construction built on accountability, communication, and operational excellence.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Navbar client:load />
	
	<!-- Hero -->
	<section class="pt-32 pb-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<img src="/images/stock/stock_photo2.JPG" alt="JBS Construction team at work" class="w-full h-full object-cover object-center opacity-25" loading="eager" />
			<div class="absolute inset-0 bg-gradient-to-r from-jbs-dark via-jbs-dark/85 to-jbs-dark/70"></div>
		</div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="max-w-3xl">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-4">About Us</p>
					<h1 class="font-heading text-6xl md:text-7xl font-800 text-white mb-6">Our Crew</h1>
					<p class="text-xl text-white/60 max-w-xl">Real people. Real accountability. Real results — in every city we build.</p>
				</div>
			</FadeInSection>
		</div>
	</section>

	<!-- What We Believe -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-16 items-start">
				<FadeInSection client:load>
					<div>
						<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">What We Believe</p>
						<h2 class="font-heading text-5xl font-800 text-jbs-dark mb-8">Building Shouldn't<br/>Be Complicated.</h2>
						<div class="space-y-4 text-jbs-charcoal/80 leading-relaxed">
							<p>We believe that communication shouldn't require chasing. That every project deserves a leader who owns the outcome.</p>
							<p>We believe in solving problems — fast. In being honest — even when it's hard. In doing the right thing — even when no one's watching.</p>
							<p>We believe people matter. Our teams. Our clients. Our subs. Everyone. Take care of people, and the work takes care of itself.</p>
							<p>We believe in new ways of building — smarter systems, better visibility, less red tape, more results.</p>
						</div>
					</div>
				</FadeInSection>
				<FadeInSection client:load>
					<div class="bg-jbs-dark p-12">
						<h3 class="font-heading text-3xl text-white uppercase mb-6">Our Promise</h3>
						<div class="space-y-4 text-white/70 leading-relaxed">
							<p>We're committed to making commercial construction clearer, easier, and faster for our national brand partners.</p>
							<p>Every project receives dedicated project management, proactive communication, and the accountability you deserve.</p>
						</div>
						<div class="mt-8 pt-8 border-t border-white/10">
							<p class="font-heading text-2xl text-jbs-blue uppercase">Building Differently — Because We Are Built Different.</p>
						</div>
					</div>
				</FadeInSection>
			</div>
		</div>
	</section>

	<!-- Core Values -->
	<section class="py-24 bg-jbs-cream">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-16">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">What Drives Us</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Core Values</h2>
				</div>
			</FadeInSection>
			<!-- Top row: 3 cards -->
			<div class="grid md:grid-cols-3 gap-8 mb-8">
				{[
					{ title: 'Accountability + Ownership', description: 'Every project has a leader. Every client has a champion. Every detail has an owner.' },
					{ title: 'Proactive Communication', description: 'Clear, consistent updates — so clients always know what\'s happening, what\'s next, and what\'s needed.' },
					{ title: 'Operational Excellence', description: 'Streamlined systems, repeatable processes, and fast, adaptive workflows.' },
				].map((value, index) => (
					<FadeInSection client:load delay={index * 0.1}>
						<div class="bg-white p-8 border-t-4 border-jbs-blue hover:shadow-xl transition-shadow">
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{value.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{value.description}</p>
						</div>
					</FadeInSection>
				))}
			</div>
			<!-- Bottom row: 2 cards centered -->
			<div class="grid md:grid-cols-2 gap-8 md:w-2/3 mx-auto">
				{[
					{ title: 'Relationship-First Leadership', description: 'We solve problems, not point fingers. We invest in people — clients, teams, and partners.' },
					{ title: 'Build + Maintain', description: 'One partner for new builds, remodels, and maintenance — creating efficiency and consistency across every site.' },
				].map((value, index) => (
					<FadeInSection client:load delay={(index + 3) * 0.1}>
						<div class="bg-white p-8 border-t-4 border-jbs-blue hover:shadow-xl transition-shadow h-full">
							<h3 class="font-heading text-xl text-jbs-dark uppercase mb-3">{value.title}</h3>
							<p class="text-jbs-charcoal/70 text-sm leading-relaxed">{value.description}</p>
						</div>
					</FadeInSection>
				))}
			</div>
		</div>
	</section>

	<!-- Meet the Team -->
	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<FadeInSection client:load>
				<div class="text-center mb-20">
					<p class="font-heading text-sm uppercase tracking-widest text-jbs-blue mb-3">Our People</p>
					<h2 class="font-heading text-5xl md:text-6xl font-800 text-jbs-dark">Meet the Team</h2>
				</div>
			</FadeInSection>

			<!-- Managing Partners -->
			<div class="mb-16">
				<FadeInSection client:load>
					<h3 class="font-heading text-xs uppercase tracking-widest text-white/70 bg-jbs-dark inline-block px-4 py-1.5 mb-10">Managing Partners</h3>
				</FadeInSection>
				<div class="grid grid-cols-2 md:grid-cols-3 gap-8 max-w-3xl">
					{[
						{ name: 'Joe Dionne', title: 'Managing Partner', photo: '/images/team/joe-dionne.jpg' },
						{ name: 'Kevin Polley', title: 'Managing Partner', photo: '/images/team/kevin-polley.jpg' },
						{ name: 'Alex Silvers', title: 'Managing Partner', photo: '/images/team/alex-silvers.jpg' },
					].map((member, i) => (
						<FadeInSection client:load delay={i * 0.08}>
							<div class="group text-center">
								<div class="aspect-square bg-jbs-beige overflow-hidden mb-4 relative">
									{member.photo ? (
										<img src={member.photo} alt={member.name} class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
									) : null}
									<div class="absolute inset-0 items-center justify-center bg-jbs-beige" style="display:none">
										<span class="font-heading text-3xl text-jbs-charcoal/30 uppercase">{member.name.split(' ').map(n => n[0]).join('')}</span>
									</div>
									<div class="absolute inset-0 bg-jbs-blue/0 group-hover:bg-jbs-blue/5 transition-all duration-300"></div>
								</div>
								<h4 class="font-heading text-xl text-jbs-dark uppercase">{member.name}</h4>
								<p class="text-jbs-blue font-heading text-xs uppercase tracking-wider mt-1">{member.title}</p>
							</div>
						</FadeInSection>
					))}
				</div>
			</div>

			<!-- Directors -->
			<div class="mb-16">
				<FadeInSection client:load>
					<h3 class="font-heading text-xs uppercase tracking-widest text-white/70 bg-jbs-dark inline-block px-4 py-1.5 mb-10">Directors</h3>
				</FadeInSection>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
					{[
						{ name: 'Shelby Fender', title: 'Director of Finance', photo: '/images/team/shelby-fender.jpg' },
						{ name: 'Kelsey Black', title: 'Director of Administration', photo: '/images/team/kelsey-black.jpg' },
					].map((member, i) => (
						<FadeInSection client:load delay={i * 0.08}>
							<div class="group text-center">
								<div class="aspect-square bg-jbs-beige overflow-hidden mb-4 relative">
									{member.photo ? (
										<img src={member.photo} alt={member.name} class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
									) : null}
									<div class="absolute inset-0 items-center justify-center bg-jbs-beige" style="display:none">
										<span class="font-heading text-3xl text-jbs-charcoal/30 uppercase">{member.name.split(' ').map(n => n[0]).join('')}</span>
									</div>
									<div class="absolute inset-0 bg-jbs-blue/0 group-hover:bg-jbs-blue/5 transition-all duration-300"></div>
								</div>
								<h4 class="font-heading text-xl text-jbs-dark uppercase">{member.name}</h4>
								<p class="text-jbs-blue font-heading text-xs uppercase tracking-wider mt-1">{member.title}</p>
							</div>
						</FadeInSection>
					))}
				</div>
			</div>

			<!-- Project Management -->
			<div class="mb-16">
				<FadeInSection client:load>
					<h3 class="font-heading text-xs uppercase tracking-widest text-white/70 bg-jbs-dark inline-block px-4 py-1.5 mb-10">Project Management</h3>
				</FadeInSection>
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
					{[
						{ name: 'Nick Silvers', title: 'Senior Project Manager', photo: '/images/team/nick-silvers.jpg' },
						{ name: 'Zane Curdes', title: 'Project Manager', photo: '/images/team/zane-curdes.jpg' },
						{ name: 'Michael Fender', title: 'Project Manager', photo: '/images/team/michael-fender.jpg' },
						{ name: 'Christian Childers', title: 'Project Manager', photo: '/images/team/christian-childers.jpg' },
						{ name: 'Christopher James', title: 'Project Manager', photo: '/images/team/christopher-james.jpg' },
						{ name: 'Justin Morton', title: 'Asst. Project Manager', photo: '/images/team/justin-morton.jpg' },
						{ name: 'Jake Thomason', title: 'Asst. Project Manager', photo: '/images/team/jake-thomason.jpg' },
						{ name: "Bobby O'Shea", title: 'Asst. Project Manager', photo: '/images/team/bobby-oshea.jpg' },
						{ name: 'Trey Ragan', title: 'Asst. Project Manager', photo: '/images/team/trey-ragan.jpg' },
						{ name: 'Corey Darby', title: 'Asst. Project Manager', photo: '/images/team/corey-darby.jpg' },
					].map((member, i) => (
						<FadeInSection client:load delay={i * 0.06}>
							<div class="group text-center">
								<div class="aspect-square bg-jbs-beige overflow-hidden mb-4 relative">
									{member.photo ? (
										<img src={member.photo} alt={member.name} class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
									) : null}
									<div class="absolute inset-0 items-center justify-center bg-jbs-beige" style="display:none">
										<span class="font-heading text-2xl text-jbs-charcoal/30 uppercase">{member.name.split(' ').map(n => n[0]).join('')}</span>
									</div>
									<div class="absolute inset-0 bg-jbs-blue/0 group-hover:bg-jbs-blue/5 transition-all duration-300"></div>
								</div>
								<h4 class="font-heading text-base text-jbs-dark uppercase">{member.name}</h4>
								<p class="text-jbs-charcoal/50 font-heading text-xs uppercase tracking-wider mt-1">{member.title}</p>
							</div>
						</FadeInSection>
					))}
				</div>
			</div>

			<!-- Operations & Administration -->
			<div>
				<FadeInSection client:load>
					<h3 class="font-heading text-xs uppercase tracking-widest text-white/70 bg-jbs-dark inline-block px-4 py-1.5 mb-10">Operations & Administration</h3>
				</FadeInSection>
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
					{[
						{ name: 'Jessica Bitner', title: 'Office Administrator', photo: '/images/team/jessica-bitner.jpg' },
						{ name: 'Emily Simpson', title: 'Accounting Associate', photo: '/images/team/emily-simpson.jpg' },
						{ name: 'Steph Perez', title: 'Construction Administrator', photo: '/images/team/steph-perez.jpg' },
						{ name: 'Lindsay Caruso', title: 'Construction Administrator', photo: '/images/team/lindsay-caruso.jpg' },
						{ name: 'Maria Siebenaller', title: 'Construction Administrator', photo: '/images/team/maria-siebenaller.jpg' },
					].map((member, i) => (
						<FadeInSection client:load delay={i * 0.06}>
							<div class="group text-center">
								<div class="aspect-square bg-jbs-beige overflow-hidden mb-4 relative">
									{member.photo ? (
										<img src={member.photo} alt={member.name} class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
									) : null}
									<div class="absolute inset-0 items-center justify-center bg-jbs-beige" style="display:none">
										<span class="font-heading text-2xl text-jbs-charcoal/30 uppercase">{member.name.split(' ').map(n => n[0]).join('')}</span>
									</div>
									<div class="absolute inset-0 bg-jbs-blue/0 group-hover:bg-jbs-blue/5 transition-all duration-300"></div>
								</div>
								<h4 class="font-heading text-base text-jbs-dark uppercase">{member.name}</h4>
								<p class="text-jbs-charcoal/50 font-heading text-xs uppercase tracking-wider mt-1">{member.title}</p>
							</div>
						</FadeInSection>
					))}
				</div>
			</div>

		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-jbs-dark relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-jbs-blue/[0.05] rotate-45 -translate-x-1/2 translate-y-1/2"></div>
		</div>
		<div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
			<FadeInSection client:load>
				<h2 class="font-heading text-5xl md:text-6xl font-800 text-white mb-6">Let's Build Together</h2>
				<div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
					<a href="/contact" class="px-10 py-4 bg-jbs-blue text-white font-heading text-lg uppercase tracking-wider hover:bg-jbs-blue/90 transition-all">Get Started</a>
					<a href="/portfolio" class="px-10 py-4 border-2 border-white/20 text-white font-heading text-lg uppercase tracking-wider hover:border-jbs-blue hover:text-jbs-blue transition-all">See Our Work</a>
				</div>
			</FadeInSection>
		</div>
	</section>

	<Footer />
</Layout>
